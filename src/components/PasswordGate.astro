---
/**
 * PasswordGate — Client-side password protection for partner review.
 *
 * Wrap any page content in this component. On load, if the user hasn't
 * entered the correct password, a fullscreen overlay blocks the content
 * and prompts for the password. The auth token is stored in sessionStorage.
 *
 * TEMPORARY: Remove this component when the masterclass goes public.
 *
 * Usage:
 *   <PasswordGate password="mikki2024">
 *     <YourPageContent />
 *   </PasswordGate>
 */
interface Props {
  password?: string;
}

const { password = 'Impact1234!' } = Astro.props;
---

<!-- Password overlay (hidden when authenticated) -->
<div id="pw-gate" style="position:fixed;inset:0;z-index:99999;background:#000;display:flex;align-items:center;justify-content:center;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;">
  <div style="max-width:400px;width:100%;padding:2rem;text-align:center;">
    <div style="font-size:1.25rem;font-weight:900;letter-spacing:0.05em;color:#fff;margin-bottom:2rem;">MIKKI MASE</div>
    <div style="background:#111;border:1px solid #2D2D2D;border-radius:1rem;padding:2rem;">
      <div style="width:48px;height:48px;margin:0 auto 1rem;background:rgba(207,181,59,0.1);border:1px solid rgba(207,181,59,0.2);border-radius:12px;display:flex;align-items:center;justify-content:center;color:#CFB53B;font-size:1.25rem;">&#128274;</div>
      <h1 style="font-size:1.25rem;font-weight:800;color:#fff;margin-bottom:0.5rem;">Partner Preview</h1>
      <p style="font-size:0.875rem;color:#9A9A9A;margin-bottom:1.5rem;">Enter the password to access the Masterclass.</p>
      <div id="pw-error" style="display:none;background:rgba(168,0,30,0.15);border:1px solid rgba(168,0,30,0.3);color:#ff6b6b;font-size:0.8125rem;padding:0.5rem 1rem;border-radius:0.5rem;margin-bottom:1rem;">
        Incorrect password. Try again.
      </div>
      <form id="pw-form" style="margin:0;">
        <input
          id="pw-input"
          type="password"
          placeholder="Enter password"
          required
          autofocus
          style="width:100%;padding:0.75rem 1rem;background:#1A1A1A;border:1px solid #3A3A3A;border-radius:0.75rem;color:#fff;font-size:1rem;outline:none;margin-bottom:1rem;box-sizing:border-box;"
        />
        <button
          type="submit"
          style="width:100%;padding:0.75rem 1rem;background:#A8001E;color:#fff;border:none;border-radius:0.75rem;font-size:1rem;font-weight:700;cursor:pointer;"
        >
          Access Masterclass
        </button>
      </form>
    </div>
    <p style="font-size:0.75rem;color:#6B6B6B;margin-top:1.5rem;">Private review only. Do not share this link publicly.</p>
  </div>
</div>

<!-- Actual page content (hidden until authenticated) -->
<div id="pw-content" style="display:none;">
  <slot />
</div>

<script define:vars={{ password }}>
  // Check if already authenticated
  const AUTH_KEY = 'mc_auth_token';

  function init() {
    const gate = document.getElementById('pw-gate');
    const content = document.getElementById('pw-content');

    if (sessionStorage.getItem(AUTH_KEY) === 'granted') {
      // Already authenticated
      gate.style.display = 'none';
      content.style.display = 'block';
      return;
    }

    // Handle form submission
    document.getElementById('pw-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const input = document.getElementById('pw-input');
      const errorEl = document.getElementById('pw-error');

      if (input.value === password) {
        sessionStorage.setItem(AUTH_KEY, 'granted');
        gate.style.display = 'none';
        content.style.display = 'block';
      } else {
        errorEl.style.display = 'block';
        input.value = '';
        input.focus();
      }
    });

    // Focus input styling
    const input = document.getElementById('pw-input');
    input.addEventListener('focus', () => {
      input.style.borderColor = '#CFB53B';
      input.style.boxShadow = '0 0 0 3px rgba(207,181,59,0.15)';
    });
    input.addEventListener('blur', () => {
      input.style.borderColor = '#3A3A3A';
      input.style.boxShadow = 'none';
    });
  }

  // Run immediately
  init();
</script>
