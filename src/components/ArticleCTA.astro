---
import Button from './Button.astro';
---

<div class="border-t-2 border-gold bg-gray-900 rounded-xl p-8 my-16 scroll-animate">
  <h3 class="text-white text-xl font-bold mb-3">Want to Learn the System?</h3>
  <p class="text-gray-400 mb-6">
    Mikki's team assembled his strategies into a structured masterclass — 10 modules, 30+ lessons, $27.
