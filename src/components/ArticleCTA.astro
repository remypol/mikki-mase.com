---
import Button from './Button.astro';
---

<div class="border-t-2 border-gold bg-gray-900 rounded-xl p-8 my-16 scroll-animate">
  <h3 class="text-white text-xl font-bold mb-3">Want more from Mikki?</h3>
  <p class="text-gray-400 mb-6">
    This is an unofficial fan page. Mikki Mase does not sell courses or masterclasses. The only thing to join is the Mikki Mase Fan Community (a free community for fans, on Telegram), where fans share strategies and stories at no cost.
  </p>
  <div class="flex flex-wrap gap-4">
    <Button variant="primary" href="/join">Join the Fan Community &rarr;</Button>
  </div>
</div>
