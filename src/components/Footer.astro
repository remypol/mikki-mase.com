---
// Footer component - minimal, clean
---

<footer class="bg-page text-primary py-16 border-t border-subtle" role="contentinfo">
  <div class="container">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 md:gap-12 mb-12">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-2">
        <h3 class="display-h3 mb-3">Mikki Mase<span class="accent-red">.</span> <span class="text-tertiary text-sm font-normal">Fan Page</span></h3>
        <p class="text-secondary max-w-sm">
          An unofficial, fan-run page celebrating the story of Mikki Mase. We are not Mikki Mase and we are not affiliated with or endorsed by him. Everything here is fan-made from his publicly available podcast and interviews.
        </p>
      </div>

      <!-- Explore -->
      <div>
        <h4 class="text-xs uppercase tracking-widest text-tertiary font-semibold mb-4">Explore</h4>
        <div class="flex flex-col gap-3">
          <a href="/story" class="text-secondary hover:text-primary transition-colors">Story</a>
          <a href="/timeline" class="text-secondary hover:text-primary transition-colors">Timeline</a>
          <a href="/wins" class="text-secondary hover:text-primary transition-colors">Wins &amp; losses</a>
          <a href="/banned" class="text-secondary hover:text-primary transition-colors">Banned</a>
          <a href="/net-worth" class="text-secondary hover:text-primary transition-colors">Net worth</a>
          <a href="/faq" class="text-secondary hover:text-primary transition-colors">FAQ</a>
        </div>
      </div>

      <!-- Learn -->
      <div>
        <h4 class="text-xs uppercase tracking-widest text-tertiary font-semibold mb-4">Learn</h4>
        <div class="flex flex-col gap-3">
          <a href="/the-system" class="text-secondary hover:text-primary transition-colors">The system</a>
          <a href="/baccarat-guide" class="text-secondary hover:text-primary transition-colors">Baccarat guide</a>
          <a href="/gambling-psychology" class="text-secondary hover:text-primary transition-colors">Psychology</a>
          <a href="/casino-advantage-play" class="text-secondary hover:text-primary transition-colors">Advantage play</a>
          <a href="/tools" class="text-secondary hover:text-primary transition-colors">Tools</a>
          <a href="/glossary" class="text-secondary hover:text-primary transition-colors">Glossary</a>
        </div>
      </div>

      <!-- Connect & Account -->
      <div>
        <h4 class="text-xs uppercase tracking-widest text-tertiary font-semibold mb-4">Connect</h4>
        <div class="flex flex-col gap-3">
          <a href="/join" class="text-secondary hover:text-primary transition-colors">Telegram community</a>
          <a href="/media" class="text-secondary hover:text-primary transition-colors">Media &amp; press</a>
          <a href="/account" class="text-secondary hover:text-primary transition-colors">Your account</a>
          <a href="/support" class="text-secondary hover:text-primary transition-colors">Support</a>
          <a href="https://www.youtube.com/@Mikki_Mase" target="_blank" rel="noopener noreferrer" class="text-secondary hover:text-primary transition-colors">YouTube ↗</a>
        </div>
      </div>
    </div>

    <!-- Bottom -->
    <div class="pt-8 border-t border-subtle flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4">
      <p class="text-tertiary text-sm">
        &copy; {new Date().getFullYear()} Unofficial Mikki Mase fan page. Not affiliated with or endorsed by Mikki Mase. All trademarks belong to their owners.
      </p>
      <div class="flex items-center gap-4 text-sm flex-wrap">
        <a href="/privacy-policy" class="text-tertiary hover:text-primary transition-colors">Privacy</a>
        <span class="text-tertiary/50">·</span>
        <a href="/terms" class="text-tertiary hover:text-primary transition-colors">Terms</a>
        <span class="text-tertiary/50">·</span>
        <a href="/responsible-gambling" class="text-tertiary hover:text-primary transition-colors">Responsible gambling</a>
      </div>
      <p class="text-tertiary text-xs max-w-sm lg:text-right">
        For educational purposes only. No guarantee of winnings. 18+ (21+ in some jurisdictions). Gambling problem? Call 1-800-522-4700.
      </p>
    </div>
  </div>
</footer>
