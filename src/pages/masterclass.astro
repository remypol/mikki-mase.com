---
// SSR: Hugo flagged that a logged-in Masterclass owner still saw "Get the
// Masterclass — $27" on this sales page. Now we detect entitlement server-side
// and render an "owned" banner above the pricing section so paid users get a
// "Continue your masterclass" CTA instead of being sold to again.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PasswordGate from '../components/PasswordGate.astro';
import { courseManifest } from '../config/course/manifest';
import { getServerClient } from '../lib/supabase';
import { ALL_ENTITLEMENT_KEYS, getHighestTier, TIER_LABELS } from '../lib/tiers';

// Framer Motion components
import MasterclassHero from '../components/motion/MasterclassHero';
import CredibilityStrip from '../components/motion/CredibilityStrip';
import WhatYouGet from '../components/motion/WhatYouGet';
import FreePreviewBanner from '../components/motion/FreePreviewBanner';
import WhoThisIsFor from '../components/motion/WhoThisIsFor';
import StudentReviews from '../components/motion/StudentReviews';
import PricingSection from '../components/motion/PricingSection';
import FinalCTA from '../components/motion/FinalCTA';
import { sessionPlaybook } from '../config/shop/products';

// Check for access=denied query param (redirect from middleware)
const accessDenied = Astro.url.searchParams.get('access') === 'denied';

// Resolve entitlement (best-effort; unauthenticated users fall through to sales page)
let ownedTier: ReturnType<typeof getHighestTier> | null = null;
let ownedTierLabel: string | null = null;
try {
  const supabase = getServerClient(Astro.cookies, Astro.request);
  const { data: { user } } = await supabase.auth.getUser();
  if (user) {
    const { data: purchases } = await supabase
      .from('purchases')
      .select('product_key')
      .eq('user_id', user.id)
      .eq('status', 'completed')
      .in('product_key', [...ALL_ENTITLEMENT_KEYS]);
    const keys = (purchases ?? []).map((p: any) => p.product_key as string);
    try {
      const { data: sub } = await supabase
        .from('subscriptions')
        .select('plan')
        .eq('user_id', user.id)
        .eq('status', 'active')
        .maybeSingle();
      if (sub?.plan === 'monthly') keys.push('inner-circle-monthly');
      if (sub?.plan === 'yearly') keys.push('inner-circle-yearly');
      if (sub?.plan === 'lifetime') keys.push('lifetime-vip');
    } catch { /* subscriptions table optional */ }
    ownedTier = getHighestTier(keys);
    ownedTierLabel = ownedTier ? TIER_LABELS[ownedTier] : null;
  }
} catch {
  // Fail open — entitlement check is an enhancement, not a gate.
}
const isOwner = !!ownedTier;

const totalLessons = courseManifest.modules.reduce((sum, m) => sum + m.lessons.length, 0);
const totalMinutes = courseManifest.modules.reduce(
  (sum, m) => sum + m.lessons.reduce((s, l) => s + l.estimatedMinutes, 0),
  0,
);
const totalHours = Math.round(totalMinutes / 60);
const modulesWithScenarios = courseManifest.modules.filter((m) => m.scenarios && m.scenarios.length > 0).length;
---

<BaseLayout
  title="The Mikki Mase Masterclass | Casino Strategy Course — $27"
  description="Negotiation, the discount system, and session discipline — the field manual behind $32M in casino wins. 10 modules, 32 lessons, interactive drills. $27 one-time."
  hideMobileNav={true}
  hideBackToTop={true}
>
  <PasswordGate>
  <Header />

  <main id="main-content">
    <!-- Owned-state banner: paid users land here via bookmark / email link and
         used to see a sales CTA. Now we acknowledge ownership and point them
         at their dashboard. Shown above the hero so it's the first thing they see. -->
    {isOwner && (
      <aside class="bg-page pt-24 pb-4" role="status" aria-live="polite">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
          <div class="stake-card flex items-center justify-between gap-4 flex-wrap">
            <div class="min-w-0">
              <p class="text-xs uppercase tracking-widest text-tertiary mb-1">You own this</p>
              <p class="display-h3 mb-0.5">Welcome back to the Masterclass<span class="accent-red">.</span></p>
              <p class="text-secondary text-sm">
                Active plan: <span class="accent-gold font-semibold">{ownedTierLabel}</span>. Your modules are ready when you are.
              </p>
            </div>
            <a
              href="/masterclass/course"
              class="inline-flex items-center gap-2 bg-accent-red text-white px-5 py-3 rounded-full font-semibold text-sm hover:brightness-110 transition whitespace-nowrap"
            >
              Go to your dashboard
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
          </div>
        </div>
      </aside>
    )}

    <!-- HERO — client:load for instant stagger animation on page load -->
    <MasterclassHero
      client:load
      totalLessons={totalLessons}
      accessDenied={accessDenied}
      isOwner={isOwner}
    />

    <!-- CREDIBILITY STRIP — client:visible for scroll-triggered counter animation -->
    <CredibilityStrip
      client:visible
      moduleCount={courseManifest.modules.length}
      totalLessons={totalLessons}
    />

    <!-- WHAT YOU GET — client:visible for staggered feature grid -->
    <WhatYouGet
      client:visible
      moduleCount={courseManifest.modules.length}
      scenarioCount={modulesWithScenarios}
    />

    <!-- FREE PREVIEW BANNER — client:visible for scroll reveal -->
    <FreePreviewBanner client:visible />

    <!-- ============================================
         CURRICULUM (Astro-native — server-rendered accordion)
         ============================================ -->
    <section class="py-16 md:py-20" id="curriculum" style="background: #0A0A0A;">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-12">
          <span class="text-xs font-bold uppercase tracking-widest" style="color: #CFB53B;">
            {courseManifest.modules.length} Modules &middot; {totalLessons}+ Lessons &middot; ~{totalHours} Hours
          </span>
          <h2 class="display-h2 article-heading mx-auto mt-3">
            Inside the Masterclass
          </h2>
          <p class="text-sm mt-3 mx-auto" style="color: #BEBEBE; max-width: 42ch;">
            Click any module to see the full lesson breakdown, quizzes, and interactive scenarios.
          </p>
        </div>

        <div class="space-y-3" id="module-accordion">
          {courseManifest.modules.map((mod) => (
            <div class="module-card rounded-xl border overflow-hidden transition-all duration-200" style="background: #141414; border-color: #2D2D2D;" data-module={mod.slug}>
              <button
                class="w-full text-left p-5 flex items-start gap-4 cursor-pointer hover:bg-white/[0.02] transition-colors"
                type="button"
                aria-expanded="false"
                data-accordion-trigger
              >
                <div class="w-11 h-11 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(207, 181, 59, 0.1); border: 1px solid rgba(207, 181, 59, 0.2);">
                  <span class="text-sm font-black" style="color: #CFB53B;">{String(mod.number).padStart(2, '0')}</span>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-bold uppercase tracking-wider" style="color: #9A9A9A;">
                      Module {mod.number}
                    </span>
                    {mod.isFreePreview && (
                      <span
                        class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded"
                        style="background: rgba(207, 181, 59, 0.12); color: #CFB53B; letter-spacing: 0.08em;"
                      >
                        Free
                      </span>
                    )}
                  </div>
                  <h3 class="text-base md:text-lg font-bold text-white mb-1">{mod.title}</h3>
                  <p class="text-xs sm:text-sm" style="color: #BEBEBE;">{mod.description}</p>
                </div>
                <svg class="w-5 h-5 flex-shrink-0 mt-1 transition-transform duration-200" style="color: #6B6B6B;" data-chevron fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <div class="accordion-content" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease;">
                <div class="px-5 pb-5 pt-0">
                  <div class="mb-4" style="border-top: 1px solid #2D2D2D;" />

                  <div class="space-y-2">
                    {mod.lessons.map((lesson, idx) => (
                      <div class="flex items-center gap-3 py-2 px-3 rounded-lg" style="background: rgba(255,255,255,0.02);">
                        <span class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-[11px] font-bold" style="background: #1A1A1A; color: #9A9A9A; border: 1px solid #2D2D2D;">
                          {idx + 1}
                        </span>
                        <span class="text-sm text-white flex-1">{lesson.title}</span>
                        <span class="text-[11px]" style="color: #6B6B6B;">{lesson.estimatedMinutes} min</span>
                      </div>
                    ))}

                    {mod.hasQuiz && (
                      <div class="flex items-center gap-3 py-2 px-3 rounded-lg" style="background: rgba(207, 181, 59, 0.04);">
                        <span class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-[11px]" style="background: rgba(207, 181, 59, 0.1); color: #CFB53B; border: 1px solid rgba(207, 181, 59, 0.2);">
                          ?
                        </span>
                        <span class="text-sm font-semibold" style="color: #CFB53B;">Module Quiz</span>
                        <span class="text-[11px]" style="color: #6B6B6B;">Scored assessment</span>
                      </div>
                    )}

                    {mod.scenarios && mod.scenarios.length > 0 && (
                      <div class="flex items-center gap-3 py-2 px-3 rounded-lg" style="background: rgba(207, 181, 59, 0.04);">
                        <span class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-[11px]" style="background: rgba(207, 181, 59, 0.1); color: #CFB53B; border: 1px solid rgba(207, 181, 59, 0.2);">
                          &#9881;
                        </span>
                        <span class="text-sm font-semibold" style="color: #CFB53B;">Interactive Scenario</span>
                        <span class="text-[11px]" style="color: #6B6B6B;">Hands-on practice</span>
                      </div>
                    )}
                  </div>

                  <div class="flex items-center gap-4 mt-4 pt-3" style="border-top: 1px solid #2D2D2D;">
                    <span class="text-xs" style="color: #9A9A9A;">
                      {mod.lessons.length} lessons &middot; ~{mod.lessons.reduce((s, l) => s + l.estimatedMinutes, 0)} min
                    </span>
                    {mod.isFreePreview && (
                      <a
                        href={`/masterclass/course/${mod.slug}/${mod.lessons[0].slug}`}
                        class="text-xs font-bold ml-auto"
                        style="color: #CFB53B;"
                      >
                        Start Free &rarr;
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WHO THIS IS FOR — client:visible for staggered list reveal -->
    <WhoThisIsFor client:visible />

    <!-- STUDENT REVIEWS — social proof before pricing -->
    <StudentReviews client:visible />

    {/* Owners don't need the pricing / final "buy" sections — replace with a
        compact "Back to your dashboard" outro. Unauth visitors still see the
        full sales funnel. */}
    {!isOwner && (
      <>
        <!-- PRICING + GUARANTEE — client:visible for premium card entrance -->
        <PricingSection client:visible />

        <!-- FINAL CTA — client:visible for staggered reveal -->
        <FinalCTA client:visible />
      </>
    )}

    {isOwner && (
      <section class="py-24 bg-page text-center">
        <div class="max-w-2xl mx-auto px-4 sm:px-6">
          <p class="eyebrow mb-3">You're in</p>
          <h2 class="display-h2 mb-4">Ready to pick up where you left off<span class="accent-red">?</span></h2>
          <p class="text-secondary mb-8">
            Your {ownedTierLabel} plan is active. Jump back into the modules whenever you're ready.
          </p>
          <a
            href="/masterclass/course"
            class="inline-flex items-center gap-2 bg-accent-red text-white px-6 py-4 rounded-full font-semibold hover:brightness-110 transition"
          >
            Open your dashboard
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
        </div>
      </section>
    )}
  </main>

  {/* Sticky mobile buy bar — only for non-owners. Owners get no sticky CTA
      (they already own it; clutter-free). */}
  {!isOwner && (
    <div id="mobile-sticky-cta" class="mobile-sticky-cta md:hidden">
      <div class="mobile-sticky-inner">
        <div class="mobile-sticky-price">
          <span class="mobile-sticky-amount">$27</span>
          <span class="mobile-sticky-label">one-time</span>
        </div>
        <a href="/checkout/playbook" class="mobile-sticky-btn">
          Get Masterclass — $27
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  )}

  <Footer />
  </PasswordGate>
</BaseLayout>

<style>
  .mobile-sticky-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(207, 181, 59, 0.3);
    padding: 12px 16px;
    padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .mobile-sticky-cta.visible {
    transform: translateY(0);
  }

  .mobile-sticky-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 480px;
    margin: 0 auto;
  }

  .mobile-sticky-price {
    display: flex;
    flex-direction: column;
  }

  .mobile-sticky-amount {
    font-size: 22px;
    font-weight: 900;
    color: white;
    line-height: 1;
  }

  .mobile-sticky-label {
    font-size: 11px;
    color: #6B6B6B;
  }

  .mobile-sticky-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 700;
    color: #000;
    background: #CFB53B;
    border-radius: 12px;
    padding: 12px 24px;
    min-height: 48px;
    flex: 1;
    max-width: 240px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .mobile-sticky-btn:active {
    transform: scale(0.98);
  }

  @media (min-width: 768px) {
    .mobile-sticky-cta {
      display: none !important;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const stickyCta = document.getElementById('mobile-sticky-cta');
    if (!stickyCta || window.innerWidth >= 768) return;

    let heroVisible = true;
    let pricingVisible = false;

    function updateVisibility() {
      // Show when hero is NOT visible AND pricing is NOT visible
      if (!heroVisible && !pricingVisible) {
        stickyCta.classList.add('visible');
      } else {
        stickyCta.classList.remove('visible');
      }
    }

    const hero = document.querySelector('#main-content > section:first-child');
    if (hero) {
      new IntersectionObserver(([entry]) => {
        heroVisible = entry.isIntersecting;
        updateVisibility();
      }, { threshold: 0.1 }).observe(hero);
    }

    const pricing = document.getElementById('pricing');
    if (pricing) {
      new IntersectionObserver(([entry]) => {
        pricingVisible = entry.isIntersecting;
        updateVisibility();
      }, { threshold: 0.15 }).observe(pricing);
    }
  });
</script>

<!-- GA4: view_item event -->
<script define:vars={{ productId: sessionPlaybook.id, productName: sessionPlaybook.name, productPrice: sessionPlaybook.price }}>
  document.addEventListener('astro:page-load', function() {
    // dataLayer for GTM
    var dataLayer = window.dataLayer || [];
    dataLayer.push({
      event: 'view_item',
      ecommerce: {
        currency: 'USD',
        value: productPrice,
        items: [{
          item_id: productId,
          item_name: productName,
          price: productPrice,
          quantity: 1
        }]
      }
    });

    // gtag for direct GA4
    if (typeof gtag !== 'undefined') {
      gtag('event', 'view_item', {
        currency: 'USD',
        value: productPrice,
        items: [{
          item_id: productId,
          item_name: productName,
          price: productPrice,
          quantity: 1
        }]
      });
    }
  });
</script>

<!-- Accordion Script -->
<script>
  document.addEventListener('astro:page-load', () => {
    const triggers = document.querySelectorAll('[data-accordion-trigger]');

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const card = trigger.closest('.module-card');
        if (!card) return;

        const content = card.querySelector('.accordion-content') as HTMLElement | null;
        const chevron = card.querySelector('[data-chevron]') as HTMLElement | null;
        if (!content) return;

        const isOpen = trigger.getAttribute('aria-expanded') === 'true';

        if (isOpen) {
          content.style.maxHeight = '0';
          trigger.setAttribute('aria-expanded', 'false');
          if (chevron) chevron.style.transform = 'rotate(0deg)';
        } else {
          triggers.forEach((otherTrigger) => {
            if (otherTrigger === trigger) return;
            const otherCard = otherTrigger.closest('.module-card');
            if (!otherCard) return;
            const otherContent = otherCard.querySelector('.accordion-content') as HTMLElement | null;
            const otherChevron = otherCard.querySelector('[data-chevron]') as HTMLElement | null;
            if (otherContent) otherContent.style.maxHeight = '0';
            otherTrigger.setAttribute('aria-expanded', 'false');
            if (otherChevron) otherChevron.style.transform = 'rotate(0deg)';
          });

          content.style.maxHeight = content.scrollHeight + 'px';
          trigger.setAttribute('aria-expanded', 'true');
          if (chevron) chevron.style.transform = 'rotate(180deg)';
        }
      });
    });
  });
</script>
