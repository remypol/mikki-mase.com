---
/**
 * Email Verified — auto-login landing page
 *
 * After Supabase email confirmation, the user lands here with
 * auth tokens in the URL hash. The client-side script picks up
 * the tokens, establishes the session, and redirects to the course.
 */

export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Email Verified | Mikki Mase"
  description="Your email has been verified."
  noIndex={true}
>
  <Header />

  <section class="min-h-screen flex items-center justify-center py-20 px-4">
    <div class="max-w-md w-full text-center">
      <div
        class="w-20 h-20 mx-auto mb-6 rounded-full flex items-center justify-center"
        style="background-color: rgba(207, 181, 59, 0.15);"
      >
        <svg class="w-10 h-10" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <h1 class="text-3xl font-bold text-white mb-3" id="status-title">Verifying your email...</h1>
      <p class="text-[#BEBEBE] mb-6" id="status-message">
        One moment, we're logging you in automatically.
      </p>

      <div id="spinner" class="flex justify-center mb-6">
        <div class="w-8 h-8 border-2 rounded-full animate-spin" style="border-color: #333; border-top-color: #CFB53B;"></div>
      </div>

      <a id="fallback-link" href="/auth/login" class="text-sm transition-colors hover:text-white hidden" style="color: #CFB53B;">
        Click here to sign in manually
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  import { getBrowserClient } from '../../lib/supabase';

  async function handleVerification() {
    const title = document.getElementById('status-title')!;
    const message = document.getElementById('status-message')!;
    const spinner = document.getElementById('spinner')!;
    const fallback = document.getElementById('fallback-link')!;

    try {
      const supabase = getBrowserClient();

      // The browser client automatically picks up tokens from the URL hash
      // Wait briefly for it to process
      const { data, error } = await supabase.auth.getSession();

      if (error) throw error;

      if (data.session) {
        title.textContent = 'Email verified!';
        message.textContent = 'Redirecting you...';
        setTimeout(() => {
          window.location.href = '/';
        }, 1000);
        return;
      }

      // If no session from hash, listen for auth state change
      const { data: { subscription } } = supabase.auth.onAuthStateChange((event, session) => {
        if (event === 'SIGNED_IN' && session) {
          subscription.unsubscribe();
          title.textContent = 'Email verified!';
          message.textContent = 'Redirecting you...';
          setTimeout(() => {
            window.location.href = '/';
          }, 1000);
        }
      });

      // Timeout fallback after 5 seconds
      setTimeout(() => {
        spinner.classList.add('hidden');
        title.textContent = 'Email verified!';
        message.textContent = 'We couldn\'t log you in automatically. Please sign in below.';
        fallback.classList.remove('hidden');
      }, 5000);

    } catch (err) {
      console.error('Verification error:', err);
      spinner.classList.add('hidden');
      title.textContent = 'Email verified!';
      message.textContent = 'Please sign in to continue.';
      fallback.classList.remove('hidden');
    }
  }

  handleVerification();
</script>
