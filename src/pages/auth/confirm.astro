---
/**
 * Email Verification Confirmation Page
 * Shown after email/password signup to remind user to check email
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PasswordGate from '../../components/PasswordGate.astro';
---

<BaseLayout
  title="Check Your Email | Mikki Mase"
  description="Verify your email to finish setting up your account."
  noIndex={true}
>
  <PasswordGate>
    <Header />

    <section class="min-h-screen flex items-center justify-center py-20 px-4">
      <div class="max-w-md w-full text-center">
        <div
          class="w-20 h-20 mx-auto mb-6 rounded-full flex items-center justify-center"
          style="background-color: rgba(207, 181, 59, 0.15);"
        >
          <svg class="w-10 h-10" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>

        <h1 class="text-3xl font-bold text-white mb-3">Check Your Email</h1>
        <p class="text-[#BEBEBE] mb-6">
          We sent a verification link to your email address.
          Click the link in the email to complete your sign-up.
        </p>

        <div class="rounded-lg p-4 mb-8" style="background-color: #1A1A1A; border: 1px solid #2D2D2D;">
          <p class="text-sm text-[#9A9A9A]">
            Didn't receive an email? Check your spam folder or
            <a href="/auth/login" class="underline transition-colors hover:text-white" style="color: #CFB53B;">
              try again
            </a>.
          </p>
        </div>

        <a href="/" class="text-sm transition-colors hover:text-white" style="color: #6B6B6B;">
          &larr; Back to Home
        </a>
      </div>
    </section>

    <Footer />
  </PasswordGate>
</BaseLayout>
