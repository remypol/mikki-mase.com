---
/**
 * Session Playbook Checkout Page ($27)
 *
 * Simplified checkout with order bump (Session Toolkit +$9).
 * Redirects to Stripe hosted checkout on submit.
 * Supports both logged-in and guest checkout.
 */

export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getServerClient, getServiceClient } from '../../lib/supabase';
import { sessionPlaybook, orderBumpConfig } from '../../config/shop/products';

// Auth is optional (guest checkout supported)
const supabase = getServerClient(Astro.cookies, Astro.request);
const { data: { user } } = await supabase.auth.getUser();

// Check existing purchase
let alreadyPurchased = false;
if (user) {
  const serviceClient = getServiceClient();
  const { data } = await serviceClient
    .from('purchases')
    .select('id')
    .eq('user_id', user.id)
    .in('product_key', ['session-playbook', 'masterclass', 'full-masterclass'])
    .eq('status', 'completed')
    .limit(1);
  if (data && data.length > 0) alreadyPurchased = true;
}

if (alreadyPurchased) return Astro.redirect('/masterclass/course');

const basePrice = sessionPlaybook.price;
const bumpPrice = orderBumpConfig.price;
---

<BaseLayout
  title="Checkout | The Session Playbook"
  description="Complete your purchase of The Session Playbook."
  noIndex={true}
  hideMobileNav={true}
  hideBackToTop={true}
>
  <Header />

  <main id="main-content" class="min-h-screen" style="background: #0A0A0A;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-16">

      <!-- Back link -->
      <a
        href="/masterclass"
        class="inline-flex items-center gap-2 text-sm mb-8 transition-colors hover:text-white"
        style="color: #6B6B6B;"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to course details
      </a>

      <!-- Two-column layout -->
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12">

        <!-- LEFT: Order Summary (sticky on desktop) -->
        <div class="lg:col-span-2 order-1 lg:order-1">
          <div
            class="rounded-2xl p-6 lg:sticky lg:top-8"
            style="background: #111; border: 1px solid #2D2D2D;"
          >
            <h2
              class="text-xs font-bold uppercase tracking-widest mb-6"
              style="color: #CFB53B;"
            >
              Order Summary
            </h2>

            <!-- Product card -->
            <div class="flex items-start gap-4 mb-6">
              <div
                class="w-14 h-14 rounded-lg flex items-center justify-center flex-shrink-0"
                style="background: rgba(207, 181, 59, 0.1); border: 1px solid rgba(207, 181, 59, 0.2);"
              >
                <svg class="w-7 h-7" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
              <div>
                <h3 class="text-white font-bold text-sm">The Session Playbook</h3>
                <p class="text-xs mt-1" style="color: #9A9A9A;">
                  One-time payment &middot; Lifetime access
                </p>
              </div>
              <span class="ml-auto text-white font-bold text-sm">${basePrice}</span>
            </div>

            <!-- Feature list -->
            <div class="space-y-2.5 mb-6">
              <div class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: #CFB53B;" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm" style="color: #BEBEBE;">Bankroll Management Framework</span>
              </div>
              <div class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: #CFB53B;" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm" style="color: #BEBEBE;">Game Selection Decision Matrix</span>
              </div>
              <div class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: #CFB53B;" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm" style="color: #BEBEBE;">Risk Management Protocols</span>
              </div>
              <div class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: #CFB53B;" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm" style="color: #BEBEBE;">Session Planning Templates</span>
              </div>
              <div class="flex items-start gap-2">
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: #CFB53B;" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="text-sm" style="color: #BEBEBE;">Lifetime Access + Future Updates</span>
              </div>
            </div>

            <!-- Order Bump -->
            <div
              id="order-bump"
              class="rounded-xl p-4 mb-6 cursor-pointer transition-all"
              style="background: rgba(207, 181, 59, 0.04); border: 2px dashed rgba(207, 181, 59, 0.3);"
            >
              <label class="flex items-start gap-3 cursor-pointer">
                <input
                  type="checkbox"
                  id="bump-checkbox"
                  class="mt-1 flex-shrink-0 w-4 h-4 rounded accent-[#CFB53B]"
                />
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-sm font-bold text-white">Add: Session Toolkit</span>
                    <span class="text-sm font-bold" style="color: #CFB53B;">+${bumpPrice}</span>
                  </div>
                  <p class="text-xs" style="color: #9A9A9A;">
                    Printable cheatsheets, bankroll tracker, and session log templates. Normally <span class="line-through">${orderBumpConfig.compareAt}</span>.
                  </p>
                </div>
              </label>
            </div>

            <!-- Dynamic total -->
            <div
              class="flex items-center justify-between py-4"
              style="border-top: 1px solid #2D2D2D;"
            >
              <span class="text-white font-semibold text-sm">Total</span>
              <div class="flex items-center gap-2">
                <span id="compare-price" class="text-base line-through" style="color: #6B6B6B;">$67</span>
                <span id="checkout-total" class="text-2xl font-black text-white">${basePrice}</span>
              </div>
            </div>

            <!-- Price reframe -->
            <p class="text-xs py-2 text-center" style="color: #9A9A9A; background: rgba(207, 181, 59, 0.05); border-radius: 8px;">
              Less than one losing hand at the table
            </p>

            <!-- Trust signals -->
            <div class="mt-6 pt-4 space-y-3" style="border-top: 1px solid #2D2D2D;">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" style="color: #059669;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span class="text-xs" style="color: #9A9A9A;">
                  Secure checkout powered by Stripe
                </span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-xs" style="color: #9A9A9A;">
                  7-day money-back guarantee
                </span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span class="text-xs" style="color: #9A9A9A;">
                  Instant access after payment
                </span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" style="color: #9A9A9A;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
                <span class="text-xs" style="color: #9A9A9A;">
                  For educational purposes only
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT: Checkout form -->
        <div class="lg:col-span-3 order-2 lg:order-2">
          <h1 class="text-white text-xl font-bold mb-2">Complete your purchase</h1>
          <p class="text-sm mb-8" style="color: #9A9A9A;">
            You'll be redirected to our secure Stripe checkout to complete payment.
          </p>

          <!-- Checkout card -->
          <div
            class="rounded-2xl p-6 md:p-8"
            style="background: #111; border: 1px solid #2D2D2D;"
          >
            <!-- Summary line -->
            <div class="flex items-center justify-between mb-6 pb-4" style="border-bottom: 1px solid #2D2D2D;">
              <div>
                <p class="text-white font-bold">The Session Playbook</p>
                <p id="bump-status" class="text-xs mt-1" style="color: #6B6B6B;">One-time payment</p>
              </div>
              <p id="checkout-amount" class="text-2xl font-black text-white">${basePrice}</p>
            </div>

            <!-- CTA Button -->
            <button
              id="checkout-btn"
              type="button"
              class="w-full inline-flex items-center justify-center gap-2 font-bold text-black min-h-[52px] rounded-xl px-8 transition-all hover:brightness-110 active:scale-[0.98]"
              style="background-color: #CFB53B;"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <span id="btn-text">Pay $<span id="btn-price">{basePrice}</span> — Secure Checkout</span>
            </button>

            <!-- Loading state (hidden by default) -->
            <div id="checkout-loading" class="hidden w-full flex items-center justify-center gap-2 min-h-[52px]">
              <svg class="w-5 h-5 animate-spin" style="color: #CFB53B;" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span class="text-white font-medium text-sm">Redirecting to checkout...</span>
            </div>

            <!-- Error message -->
            <div id="checkout-error" class="hidden mt-4 rounded-lg px-4 py-3 text-sm" style="background: rgba(220, 38, 38, 0.1); border: 1px solid rgba(220, 38, 38, 0.3); color: #FCA5A5;">
            </div>

            <!-- Payment methods -->
            <div class="flex items-center justify-center gap-4 mt-6">
              <span class="text-[10px] uppercase tracking-wider" style="color: #6B6B6B;">Powered by</span>
              <span class="text-xs font-bold" style="color: #9A9A9A;">Stripe</span>
              <span class="text-[10px]" style="color: #4A4A4A;">|</span>
              <span class="text-[10px]" style="color: #6B6B6B;">Card, Apple Pay, Google Pay</span>
            </div>
          </div>

          <!-- Social proof reviews -->
          <div class="mt-8 space-y-4">
            <div
              class="rounded-xl p-5"
              style="background: #111; border: 1px solid #2D2D2D;"
            >
              <div class="flex items-center gap-1 mb-2">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-4 h-4" style="color: #CFB53B;" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-sm text-white leading-relaxed">
                "Finally someone who actually explains the math instead of selling a 'system.' The bankroll management section alone changed how I approach every session."
              </p>
              <p class="text-xs mt-2" style="color: #6B6B6B;">Marcus T. &mdash; Verified Buyer</p>
            </div>

            <div
              class="rounded-xl p-5"
              style="background: #111; border: 1px solid #2D2D2D;"
            >
              <div class="flex items-center gap-1 mb-2">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-4 h-4" style="color: #CFB53B;" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-sm text-white leading-relaxed">
                "Mikki breaks down exactly how to think like a professional. The risk management framework is worth 10x the price."
              </p>
              <p class="text-xs mt-2" style="color: #6B6B6B;">Daniel K. &mdash; Verified Buyer</p>
            </div>
          </div>

          <!-- Disclaimer -->
          <div class="mt-8 rounded-lg p-4" style="background: rgba(255,255,255,0.02); border: 1px solid #1A1A1A;">
            <p class="text-[11px] leading-relaxed" style="color: #4A4A4A;">
              <strong style="color: #6B6B6B;">Disclaimer:</strong> This product is for educational and entertainment purposes only. Gambling involves risk and you may lose money. Nothing in this content constitutes financial advice, a guarantee of winnings, or an endorsement of gambling. Always gamble responsibly and within your means. By purchasing, you agree to our <a href="/terms" class="underline" style="color: #6B6B6B;">Terms of Service</a> and <a href="/privacy" class="underline" style="color: #6B6B6B;">Privacy Policy</a>.
            </p>
          </div>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<!-- Client-side: bump toggle + checkout redirect -->
<script define:vars={{ basePrice, bumpPrice }}>
  document.addEventListener('astro:page-load', () => {
    const checkbox = document.getElementById('bump-checkbox');
    const totalEl = document.getElementById('checkout-total');
    const amountEl = document.getElementById('checkout-amount');
    const btnPriceEl = document.getElementById('btn-price');
    const bumpStatusEl = document.getElementById('bump-status');
    const comparePriceEl = document.getElementById('compare-price');
    const checkoutBtn = document.getElementById('checkout-btn');
    const loadingEl = document.getElementById('checkout-loading');
    const errorEl = document.getElementById('checkout-error');
    const bumpCard = document.getElementById('order-bump');

    if (!checkbox || !totalEl || !checkoutBtn) return;

    function updateTotal() {
      const includeBump = checkbox.checked;
      const total = includeBump ? basePrice + bumpPrice : basePrice;
      const compareTotal = includeBump ? 67 + 29 : 67;

      totalEl.textContent = '$' + total;
      if (amountEl) amountEl.textContent = '$' + total;
      if (btnPriceEl) btnPriceEl.textContent = total;
      if (comparePriceEl) comparePriceEl.textContent = '$' + compareTotal;
      if (bumpStatusEl) {
        bumpStatusEl.textContent = includeBump
          ? 'Playbook + Session Toolkit'
          : 'One-time payment';
      }

      // Visual feedback on bump card
      if (bumpCard) {
        if (includeBump) {
          bumpCard.style.borderColor = 'rgba(207, 181, 59, 0.6)';
          bumpCard.style.background = 'rgba(207, 181, 59, 0.08)';
        } else {
          bumpCard.style.borderColor = 'rgba(207, 181, 59, 0.3)';
          bumpCard.style.background = 'rgba(207, 181, 59, 0.04)';
        }
      }
    }

    checkbox.addEventListener('change', updateTotal);

    // Checkout redirect
    checkoutBtn.addEventListener('click', async () => {
      checkoutBtn.style.display = 'none';
      if (loadingEl) loadingEl.classList.remove('hidden');
      if (errorEl) errorEl.classList.add('hidden');

      try {
        const res = await fetch('/api/checkout/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            productKey: 'session-playbook',
            includeBump: checkbox.checked,
          }),
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || 'Checkout failed');
        }

        if (data.url) {
          window.location.href = data.url;
        } else {
          throw new Error('No checkout URL returned');
        }
      } catch (err) {
        checkoutBtn.style.display = 'inline-flex';
        if (loadingEl) loadingEl.classList.add('hidden');
        if (errorEl) {
          errorEl.textContent = err.message || 'Something went wrong. Please try again.';
          errorEl.classList.remove('hidden');
        }
      }
    });
  });
</script>

<style>
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin {
    animation: spin 1s linear infinite;
  }
</style>
