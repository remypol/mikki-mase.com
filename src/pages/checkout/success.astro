---
/**
 * Checkout Success Page
 * Shows order confirmation and download link for digital products
 */

// This page must be server-rendered (dynamic session lookup)
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getStripeServer } from '../../lib/stripe';
import { getProductById } from '../../config/shop/products';
import { generateDownloadToken } from '../../lib/downloads';
import { getServerClient } from '../../lib/supabase';

// Get session or payment intent from URL
const sessionId = Astro.url.searchParams.get('session_id');
const paymentIntentId = Astro.url.searchParams.get('payment_intent');
const redirectStatus = Astro.url.searchParams.get('redirect_status');

let product: { id: string; name: string; price: number; [key: string]: any } | null = null;
let downloadUrl = null;
let customerEmail = null;
let error = null;
let isMasterclass = false;
let cheatsheetDownloadUrl = '';
let ebookDownloadUrl = '';
let masterclassUserVerified = false;
let maskedEmail = '';
let metadataUserId = '';
let isGuestCheckout = false;

// Check if user is coming from upsell (skip upsell redirect)
const fromUpsell = Astro.url.searchParams.get('from_upsell') === 'true';

// Handle PaymentIntent redirect (from custom Payment Element checkout)
if (paymentIntentId && !sessionId) {
  try {
    const stripe = await getStripeServer();
    const pi = await stripe.paymentIntents.retrieve(paymentIntentId);

    if (pi.status === 'succeeded') {
      const productKey = pi.metadata?.productKey;
      metadataUserId = pi.metadata?.userId || '';
      customerEmail = pi.receipt_email || pi.metadata?.userEmail || null;

      // Upsell redirect: if they bought the base masterclass and haven't seen the upsell yet
      if (productKey === 'masterclass' && !fromUpsell) {
        const upsellParams = new URLSearchParams();
        upsellParams.set('payment_intent', paymentIntentId);
        if (redirectStatus) upsellParams.set('redirect_status', redirectStatus);
        return Astro.redirect(`/checkout/upsell?${upsellParams.toString()}`);
      }

      const masterclassTiers = ['masterclass', 'inner-circle-yearly', 'lifetime-vip'];
      if (productKey && masterclassTiers.includes(productKey)) {
        isMasterclass = true;
        const tierNames: Record<string, string> = {
          masterclass: 'Mikki Mase Masterclass',
          'inner-circle-yearly': 'Inner Circle Annual',
          'lifetime-vip': 'Lifetime VIP',
        };
        const tierPrices: Record<string, number> = { masterclass: 67, 'inner-circle-yearly': 99.99, 'lifetime-vip': 249 };
        product = { id: productKey, name: tierNames[productKey] || 'Masterclass', price: tierPrices[productKey] || 67 };

        if (metadataUserId) {
          try {
            const supabase = getServerClient(Astro.cookies, Astro.request);
            const { data: { user } } = await supabase.auth.getUser();
            if (user && user.id === metadataUserId) {
              masterclassUserVerified = true;
            }
          } catch { /* Auth check failed */ }
        }

        if (masterclassUserVerified && customerEmail) {
          const csToken = generateDownloadToken('mmc-cheatsheet-bundle', customerEmail, paymentIntentId);
          const ebToken = generateDownloadToken('beat-the-casino', customerEmail, paymentIntentId);
          cheatsheetDownloadUrl = `/download/${csToken}`;
          ebookDownloadUrl = `/download/${ebToken}`;
        }

        if (customerEmail) {
          const [localPart, domain] = customerEmail.split('@');
          maskedEmail = localPart.slice(0, 2) + '***@' + domain;
        }
      }
    } else {
      error = 'Payment has not been completed yet.';
    }
  } catch (e) {
    console.error('Error retrieving PaymentIntent:', e);
    error = 'Unable to verify payment.';
  }
}

if (sessionId) {
  try {
    // Retrieve session from Stripe
    const stripe = await getStripeServer();
    const session = await stripe.checkout.sessions.retrieve(sessionId, {
      expand: ['line_items', 'customer_details'],
    });

    // Verify payment was successful
    if (session.payment_status === 'paid') {
      const productId = session.metadata?.productId;
      const productKey = session.metadata?.productKey;
      product = productId ? getProductById(productId) ?? null : null;
      customerEmail = session.customer_details?.email;
      metadataUserId = session.metadata?.userId || '';

      // Masterclass tier purchase (masterclass, inner-circle-yearly, lifetime-vip)
      const sessionMasterclassTiers = ['masterclass', 'inner-circle-yearly', 'lifetime-vip'];
      if (productKey && sessionMasterclassTiers.includes(productKey)) {
        isMasterclass = true;
        isGuestCheckout = session.metadata?.isGuestCheckout === 'true' || !metadataUserId;

        // Ensure product is set for GA4 tracking
        if (!product) {
          const sTierNames: Record<string, string> = {
            masterclass: 'The Mikki Mase Masterclass',
            'inner-circle-yearly': 'Inner Circle Annual',
            'lifetime-vip': 'Lifetime VIP',
          };
          const sTierPrices: Record<string, number> = { masterclass: 67, 'inner-circle-yearly': 99.99, 'lifetime-vip': 249 };
          product = { id: productKey, name: sTierNames[productKey] || 'Masterclass', price: sTierPrices[productKey] || 67 };
        }

        // Issue #5: Verify logged-in user matches the purchaser before showing download links
        if (metadataUserId) {
          try {
            const supabase = getServerClient(Astro.cookies, Astro.request);
            const { data: { user } } = await supabase.auth.getUser();
            if (user && user.id === metadataUserId) {
              masterclassUserVerified = true;
              isGuestCheckout = false;
            }
          } catch {
            // Auth check failed — treat as unverified
          }
        }

        // Only generate download links if user is verified
        if (masterclassUserVerified && customerEmail) {
          const csToken = generateDownloadToken('mmc-cheatsheet-bundle', customerEmail, sessionId);
          const ebToken = generateDownloadToken('beat-the-casino', customerEmail, sessionId);
          cheatsheetDownloadUrl = `/download/${csToken}`;
          ebookDownloadUrl = `/download/${ebToken}`;
        }

        // Mask email for unverified/guest users
        if (customerEmail) {
          const [localPart, domain] = customerEmail.split('@');
          if (localPart && domain) {
            const visible = localPart.length <= 2 ? localPart[0] : localPart.slice(0, 2);
            maskedEmail = `${visible}${'*'.repeat(Math.max(localPart.length - 2, 1))}@${domain}`;
          }
        }
      } else if (product && product.fulfillment === 'digital' && customerEmail) {
        // Legacy digital product
        const token = generateDownloadToken(productId!, customerEmail, sessionId);
        downloadUrl = `/download/${token}`;
      }
    } else {
      error = 'Payment not completed';
    }
  } catch (err) {
    console.error('Error retrieving session:', err);
    error = 'Unable to verify purchase';
  }
} else {
  error = 'No session ID provided';
}
---

<BaseLayout
  title={error ? 'Confirming your order… | Mikki Mase' : 'Purchase Complete | Mikki Mase'}
  description={error ? 'We are confirming your purchase.' : 'Your purchase was successful. Access your download link below. Thank you for your order from Mikki Mase.'}
  noIndex={true}
>
  <Header />

  <section class="min-h-screen flex items-center justify-center py-20 px-4">
    <div class="max-w-md w-full">

      {error ? (
        <!--
          "Error" here doesn't necessarily mean the payment failed — most often it
          means the user landed without a session_id (e.g. refresh, back button,
          opened an old email link). Show a reassuring state with a recovery path,
          not "Something went wrong".
        -->
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center" style="background: rgba(207, 181, 59, 0.12);">
            <svg class="w-8 h-8" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-white mb-3">We're still confirming your order</h1>
          <p class="text-gray-400 mb-2">
            If you just paid, your receipt and access link are on their way to your inbox — this usually takes under a minute.
          </p>
          <p class="text-gray-500 text-sm mb-8">
            No charge will appear if the payment didn't complete. Details: {error}.
          </p>
          <div class="flex flex-col sm:flex-row items-stretch justify-center gap-3">
            <a
              href="/masterclass/course"
              class="inline-flex items-center justify-center gap-2 font-bold text-black min-h-[48px] rounded-lg px-6 transition-all hover:brightness-110"
              style="background-color: #CFB53B;"
            >
              Go to your dashboard
            </a>
            <a
              href="mailto:support@mikki-mase.com?subject=Order%20confirmation"
              class="inline-flex items-center justify-center gap-2 font-medium text-white border border-gray-700 min-h-[48px] rounded-lg px-6 transition-colors hover:bg-white/5"
            >
              Email support
            </a>
          </div>
        </div>

      ) : isMasterclass ? (
        <!-- Masterclass Success State -->
        <div class="text-center">

          <!-- Success icon -->
          <div class="w-20 h-20 mx-auto mb-6 rounded-full flex items-center justify-center animate-scale" style="background: rgba(207, 181, 59, 0.2);">
            <svg class="w-10 h-10" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>

          <h1 class="text-3xl font-bold text-white mb-2">Welcome to the Masterclass</h1>
          <p class="text-lg mb-8" style="color: #CFB53B;">You now have lifetime access</p>

          <!-- Course CTA: different for guest vs authenticated -->
          {isGuestCheckout ? (
            <!-- Guest checkout: direct to check email -->
            <div class="mb-6">
              <div
                class="rounded-xl p-6 text-left mb-4"
                style="background: rgba(207, 181, 59, 0.08); border: 1px solid rgba(207, 181, 59, 0.25);"
              >
                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 flex-shrink-0 mt-0.5" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <div>
                    <p class="text-white font-bold text-base mb-1">Check your email to access the course</p>
                    <p class="text-sm" style="color: #BEBEBE;">
                      We've sent a <strong class="text-white">one-click login link</strong> to <strong class="text-white">{maskedEmail || 'your email'}</strong>. Click it to access your masterclass instantly. No password needed.
                    </p>
                  </div>
                </div>
              </div>
              <p class="text-xs text-center" style="color: #6B6B6B;">
                Already have an account? <a href="/auth/login?next=/masterclass/course" class="hover:underline" style="color: #CFB53B;">Sign in here</a>
              </p>
            </div>
          ) : (
            <!-- Authenticated: polling for webhook completion -->
            <div id="masterclass-cta">
              <div id="mc-polling" class="flex flex-col items-center gap-3 mb-6">
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5 animate-spin" style="color: #CFB53B;" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <span class="text-white font-medium text-sm">Unlocking your access...</span>
                </div>
              </div>
              <a
                id="mc-cta-btn"
                href="/masterclass/course"
                class="w-full inline-flex items-center justify-center gap-2 font-bold text-black min-h-[52px] rounded-xl px-8 transition-all hover:brightness-110 active:scale-[0.98] mb-6"
                style="background-color: #CFB53B; display: none;"
              >
                Start the Masterclass
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
              <div id="mc-timeout-msg" class="rounded-lg px-4 py-3 mb-6 text-sm text-left" style="display: none; background: rgba(207, 181, 59, 0.1); border: 1px solid rgba(207, 181, 59, 0.2);">
                <p class="text-white font-medium mb-1">Access is being set up</p>
                <p style="color: #BEBEBE;">You'll receive a confirmation email shortly. You can also try <button id="mc-refresh-btn" class="underline" style="color: #CFB53B;">refreshing this page</button> in a few seconds.</p>
              </div>
            </div>
          )}

          <!-- Issue #5: Only show bonus downloads to verified users -->
          {masterclassUserVerified && (cheatsheetDownloadUrl || ebookDownloadUrl) && (
            <div class="rounded-xl p-6 text-left mb-6" style="background: #1A1A1A; border: 1px solid #2D2D2D;">
              <h3 class="text-sm font-bold mb-4" style="color: #CFB53B;">Your Bonus Downloads</h3>
              <div class="space-y-3">
                {cheatsheetDownloadUrl && (
                  <a href={cheatsheetDownloadUrl} class="flex items-center gap-3 text-white hover:text-[#CFB53B] transition-colors group">
                    <svg class="w-5 h-5 text-[#9A9A9A] group-hover:text-[#CFB53B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span class="text-sm font-medium">MMC Cheatsheet Bundle</span>
                  </a>
                )}
                {ebookDownloadUrl && (
                  <a href={ebookDownloadUrl} class="flex items-center gap-3 text-white hover:text-[#CFB53B] transition-colors group">
                    <svg class="w-5 h-5 text-[#9A9A9A] group-hover:text-[#CFB53B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span class="text-sm font-medium">Beat the Casino Ebook (98 pages)</span>
                  </a>
                )}
              </div>
            </div>
          )}

          <!-- Telegram CTA -->
          <div class="rounded-xl p-6 text-left" style="background: #0A0A0A; border: 1px solid rgba(207, 181, 59, 0.2);">
            <h3 class="text-white font-bold text-base mb-2">Join the Community</h3>
            <p class="text-sm mb-4" style="color: #BEBEBE;">Connect with other serious players in the free Telegram group.</p>
            <a href="/join" class="inline-flex items-center gap-2 font-semibold text-sm transition-colors hover:underline" style="color: #CFB53B;">
              Join Telegram Free
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
          </div>

          <!-- Email notice -->
          <div class="rounded-lg p-4 text-left mt-6" style="background: #111; border: 1px solid #2D2D2D;">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 flex-shrink-0 mt-0.5" style="color: #CFB53B;" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
              </svg>
              <div>
                <p class="text-white font-medium text-sm">Check your email</p>
                <p class="text-sm" style="color: #9A9A9A;">
                  {isGuestCheckout
                    ? `We sent a login link and bonus downloads to ${maskedEmail || 'your email'}. Click the link to access your masterclass instantly.`
                    : masterclassUserVerified
                      ? `We sent a welcome email with bonus download links to ${customerEmail}`
                      : `We sent a welcome email with bonus download links to ${maskedEmail || 'your email'}. Check your inbox to access them.`
                  }
                </p>
              </div>
            </div>
          </div>

          <p class="text-sm mt-6" style="color: #6B6B6B;">
            Questions? <a href="mailto:support@mikki-mase.com" class="hover:underline" style="color: #CFB53B;">Contact support</a>
          </p>

        </div>

      ) : (
        <!-- Standard Success State -->
        <div class="text-center">

          <!-- Success icon -->
          <div class="w-20 h-20 mx-auto mb-6 bg-green-500/20 rounded-full flex items-center justify-center animate-scale">
            <svg class="w-10 h-10 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>

          <!-- Headline -->
          <h1 class="text-3xl font-bold text-white mb-2">You're in.</h1>
          <p class="text-gold text-lg mb-8">Purchase successful</p>

          <!-- Product card -->
          {product && (
            <div class="bg-gray-800 border border-gray-700 rounded-lg p-6 mb-8 text-left">
              <div class="flex items-start gap-4">
                <img
                  src={product.cover}
                  alt={product.name}
                  class="w-20 h-28 object-cover rounded"
                />
                <div>
                  <p class="text-gold text-sm">{product.tagline}</p>
                  <h3 class="text-white font-semibold text-lg">{product.name}</h3>
                  <p class="text-gray-400 text-sm mt-1">
                    Sent to: {customerEmail}
                  </p>
                </div>
              </div>
            </div>
          )}

          <!-- Download button -->
          {downloadUrl && (
            <a
              href={downloadUrl}
              class="w-full inline-flex items-center justify-center gap-2 bg-mikki-red text-white
                     font-semibold px-6 py-4 rounded-lg hover:bg-red-700 transition-colors mb-4"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Download Now
            </a>
          )}

          <!-- Email notice -->
          <div class="bg-gray-900 border border-gray-800 rounded-lg p-4 text-left">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
              </svg>
              <div>
                <p class="text-white font-medium text-sm">Check your email</p>
                <p class="text-gray-400 text-sm">
                  We've also sent a download link to {customerEmail}
                </p>
              </div>
            </div>
          </div>

          <!-- Cross-sell -->
          {product && product.id === 'mmc-cheatsheet-bundle' && (
            <div class="bg-gray-900 border border-gold/30 rounded-lg p-6 mt-6 text-left">
              <p class="text-gold text-sm uppercase tracking-wider mb-2">Next Level</p>
              <h3 class="text-white font-bold text-lg mb-2">Want the Full Playbook?</h3>
              <p class="text-gray-400 text-sm mb-4">Go deeper with our 98-page ebook on casino psychology and advantage play.</p>
              <a href="/beat-the-casino" class="inline-flex items-center gap-2 bg-[#A8001E] text-white font-semibold px-5 py-3 rounded-lg hover:bg-[#8B0018] transition-colors text-sm">
                Beat the Casino — $29
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
              </a>
            </div>
          )}

          {product && product.id === 'beat-the-casino' && (
            <div class="bg-gray-900 border border-gold/30 rounded-lg p-6 mt-6 text-left">
              <p class="text-gold text-sm uppercase tracking-wider mb-2">Complete Your Arsenal</p>
              <h3 class="text-white font-bold text-lg mb-2">Get the Strategy Cheat Sheets</h3>
              <p class="text-gray-400 text-sm mb-4">Baccarat, Poker, and Roulette quick-reference cards for the table.</p>
              <a href="/cheatsheets" class="inline-flex items-center gap-2 bg-[#A8001E] text-white font-semibold px-5 py-3 rounded-lg hover:bg-[#8B0018] transition-colors text-sm">
                Cheatsheet Bundle — $19.99
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
              </a>
            </div>
          )}

          {product && product.id === 'ultimate-mmc-bundle' && (
            <div class="bg-gray-900 border border-gold/30 rounded-lg p-6 mt-6 text-left">
              <p class="text-gold text-sm uppercase tracking-wider mb-2">You've Got Everything</p>
              <h3 class="text-white font-bold text-lg mb-2">Join the Community</h3>
              <p class="text-gray-400 text-sm mb-4">Connect with other players in the free Telegram group.</p>
              <a href="/join" class="inline-flex items-center gap-2 bg-gold text-black font-semibold px-5 py-3 rounded-lg hover:bg-gold/90 transition-colors text-sm">
                Join Telegram Free
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
              </a>
            </div>
          )}

          <!-- Support link -->
          <p class="text-gray-500 text-sm mt-6">
            Questions? <a href="mailto:support@mikki-mase.com" class="text-gold hover:underline">
              Contact support
            </a>
          </p>

        </div>
      )}

    </div>
  </section>

  <Footer />

  <!-- GA4 Ecommerce: Purchase Event (with duplicate prevention) -->
  {product && sessionId && (
    <script
      is:inline
      define:vars={{
        transactionId: sessionId,
        ga4ProductId: product.id,
        ga4ProductName: product.name,
        ga4ProductPrice: product.price
      }}
    >
      document.addEventListener('astro:page-load', function() {
        // Prevent duplicate purchase tracking on page refresh
        var trackedKey = 'purchase_tracked_' + transactionId;

        // Check if this purchase was already tracked
        if (sessionStorage.getItem(trackedKey)) {
          console.log('[GA4] purchase already tracked, skipping:', transactionId);
          return;
        }

        // Ensure dataLayer exists
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}

        // Fire purchase event
        gtag('event', 'purchase', {
          transaction_id: transactionId,
          value: ga4ProductPrice,
          currency: 'USD',
          items: [{
            item_id: ga4ProductId,
            item_name: ga4ProductName,
            price: ga4ProductPrice,
            quantity: 1
          }]
        });

        // Mark as tracked to prevent duplicates
        sessionStorage.setItem(trackedKey, 'true');
        console.log('[GA4] purchase fired:', transactionId, ga4ProductPrice);
      });
    </script>
  )}

  <!-- Masterclass purchase status polling (only for authenticated users, not guests) -->
  {isMasterclass && !isGuestCheckout && (
    <script is:inline>
      document.addEventListener('astro:page-load', function() {
        var polling = document.getElementById('mc-polling');
        var ctaBtn = document.getElementById('mc-cta-btn');
        var timeoutMsg = document.getElementById('mc-timeout-msg');
        var refreshBtn = document.getElementById('mc-refresh-btn');
        if (!polling || !ctaBtn || !timeoutMsg) return;

        if (refreshBtn) {
          refreshBtn.addEventListener('click', function() {
            window.location.reload();
          });
        }

        var attempts = 0;
        var maxAttempts = 5;
        var interval = 2000;

        function showCta() {
          polling.style.display = 'none';
          ctaBtn.style.display = 'inline-flex';
        }

        function showTimeout() {
          polling.style.display = 'none';
          timeoutMsg.style.display = 'block';
        }

        function pollStatus() {
          attempts++;
          fetch('/api/purchase-status', { credentials: 'same-origin', cache: 'no-store' })
            .then(function(res) { return res.json(); })
            .then(function(data) {
              if (data.purchased) {
                showCta();
              } else if (attempts >= maxAttempts) {
                showTimeout();
              } else {
                setTimeout(pollStatus, interval);
              }
            })
            .catch(function() {
              if (attempts >= maxAttempts) {
                showTimeout();
              } else {
                setTimeout(pollStatus, interval);
              }
            });
        }

        pollStatus();
      });
    </script>
  )}
</BaseLayout>

<style>
  @keyframes scale {
    0% { transform: scale(0); opacity: 0; }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); opacity: 1; }
  }

  .animate-scale {
    animation: scale 0.5s ease-out;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }
</style>
