---
/**
 * Embedded Masterclass Checkout Page
 *
 * Renders the Stripe payment form directly on our site.
 * Supports both logged-in and guest checkout.
 * Purchase-gated: redirects to course if already purchased (logged-in users only).
 */

export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CustomMasterclassCheckout from '../../components/CustomMasterclassCheckout';
import UrgencyTimer from '../../components/UrgencyTimer';
import { getServerClient } from '../../lib/supabase';
import { ALL_ENTITLEMENT_KEYS, getHighestTier } from '../../lib/tiers';

// Auth is OPTIONAL — supports both logged-in and guest checkout
const supabase = getServerClient(Astro.cookies, Astro.request);
const { data: { user } } = await supabase.auth.getUser();

// Get tier from query param (default: masterclass)
const tier = Astro.url.searchParams.get('tier') || 'masterclass';

const TIER_INFO: Record<string, { price: number; compareAt: number; label: string; billing: string; features: string[] }> = {
  masterclass: {
    price: 67,
    compareAt: 197,
    label: 'The Mikki Mase Masterclass',
    billing: 'One-time payment · Lifetime access',
    features: [
      '10 Modules of Casino Strategy',
      '30+ In-Depth Lessons (~8 hours)',
      'Interactive Scenarios & Quizzes',
      'MMC Cheatsheet Bundle (Bonus)',
      'Beat the Casino Ebook (Bonus)',
      'Lifetime Access + Future Updates',
    ],
  },
  'inner-circle-yearly': {
    price: 99.99,
    compareAt: 179.88,
    label: 'Inner Circle Annual',
    billing: '$8.33/mo · Billed annually · Cancel anytime',
    features: [
      'Everything in the Masterclass',
      'Inner Circle Community Access',
      'Monthly Strategy Updates',
      'New Scenarios & Quizzes Monthly',
      'AI Casino Strategy Advisor',
      'Member Leaderboard & Challenges',
    ],
  },
  'lifetime-vip': {
    price: 249,
    compareAt: 497,
    label: 'Lifetime VIP',
    billing: 'One-time payment · Everything forever',
    features: [
      'Everything in the Inner Circle',
      'Lifetime Access (Never Pay Again)',
      'Founding Member Badge',
      'Priority Support',
      'All Future Content Included',
      'Limited to 500 Members',
    ],
  },
};

const tierInfo = TIER_INFO[tier] || TIER_INFO.masterclass;
const displayPrice = tierInfo.price;

// Entitlement guard — tier-weight logic (v2 after Gemini + GPT review).
//
// Two competing risks this guard balances:
//   1. Accidental re-charge: the saved-card one-click "Pay" button must not
//      re-charge a user who already owns the same or a lower tier.
//   2. Upgrade path MUST stay open: a Masterclass owner buying Inner Circle,
//      or an Inner Circle owner buying Lifetime VIP, is legitimate.
//
// Rule: redirect iff (target tier rank) <= (owned tier rank).
// Allow if target rank is strictly higher (real upgrade).
//
// We use the RLS-aware server client (not the service client) per GPT 5.4
// HIGH: "my own purchases" should run through normal RLS like other
// authenticated queries.
//
// KNOWN GAP (tracked, not fixed here): a paid user who is NOT logged in
// could still reach this page. Stripe-side duplicate prevention (same-email
// detection, customer_update) is the next iteration — Gemini CRITICAL #3.
const TIER_RANK: Record<string, number> = {
  masterclass: 1,
  'inner-circle': 2,
  'lifetime-vip': 3,
};
function tierRank(t: string | null | undefined): number {
  if (!t) return 0;
  return TIER_RANK[t] ?? 0;
}

if (user) {
  const { data: existingPurchase, error: purchaseError } = await supabase
    .from('purchases')
    .select('id, product_key')
    .eq('user_id', user.id)
    .in('product_key', ALL_ENTITLEMENT_KEYS as any)
    .eq('status', 'completed');

  if (purchaseError) {
    console.error('Purchase check error:', purchaseError);
  }

  const ownedKeys = existingPurchase?.map((p: any) => p.product_key as string) ?? [];
  const ownedTier = getHighestTier(ownedKeys);

  // Normalise both the yearly + monthly inner-circle skus back to 'inner-circle'
  const targetTier =
    tier === 'inner-circle-yearly' || tier === 'inner-circle-monthly'
      ? 'inner-circle'
      : tier;

  // Lifetime owners already own everything — never a reason to reach checkout.
  if (ownedTier === 'lifetime-vip') {
    return Astro.redirect('/masterclass/course');
  }

  // Redirect only if target tier is equal-or-lower than what they own.
  // Strictly higher tier passes through (legit upgrade).
  if (ownedTier && tierRank(targetTier) <= tierRank(ownedTier)) {
    return Astro.redirect('/masterclass/course?returning=1');
  }
}
---

<BaseLayout
  title="Checkout | The Mikki Mase Masterclass"
  description="Complete your purchase of The Mikki Mase Masterclass."
  noIndex={true}
  hideMobileNav={true}
  hideBackToTop={true}
>
  <Header />

  <main id="main-content" class="min-h-screen" style="background: #0A0A0A;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-16">

      <!-- Back link -->
      <a
        href="/masterclass"
        class="inline-flex items-center gap-2 text-sm mb-8 transition-colors hover:text-white"
        style="color: #6B6B6B;"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to course details
      </a>

      <!-- Two-column layout -->
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12">

        <!-- LEFT: Order Summary (on desktop) / below checkout (on mobile) -->
        <div class="lg:col-span-2 order-2 lg:order-1">
          <div
            class="rounded-2xl p-6 lg:sticky lg:top-8"
            style="background: #111; border: 1px solid #2D2D2D;"
          >
            <h2
              class="text-xs font-bold uppercase tracking-widest mb-6"
              style="color: #CFB53B;"
            >
              Order Summary
            </h2>

            <!-- Product card -->
            <div class="flex items-start gap-4 mb-6">
              <div
                class="w-14 h-14 rounded-lg flex items-center justify-center flex-shrink-0"
                style="background: rgba(207, 181, 59, 0.1); border: 1px solid rgba(207, 181, 59, 0.2);"
              >
                <svg class="w-7 h-7" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
              <div>
                <h3 class="text-white font-bold text-sm">{tierInfo.label}</h3>
                <p class="text-xs mt-1" style="color: #9A9A9A;">
                  {tierInfo.billing}
                </p>
              </div>
            </div>

            <!-- Price -->
            <div
              class="flex items-center justify-between py-4"
              style="border-top: 1px solid #2D2D2D;"
            >
              <span class="text-white font-semibold text-sm">Total</span>
              <div class="flex items-center gap-2">
                <span class="text-base line-through" style="color: #6B6B6B;">${tierInfo.compareAt % 1 === 0 ? tierInfo.compareAt : tierInfo.compareAt.toFixed(2)}</span>
                <span id="checkout-price" class="text-2xl font-black text-white">${displayPrice % 1 === 0 ? displayPrice : displayPrice.toFixed(2)}</span>
              </div>
            </div>

            <!-- Price reframe -->
            <p class="text-xs py-2 text-center" style="color: #9A9A9A; background: rgba(207, 181, 59, 0.05); border-radius: 8px;">
              Less than one losing hand at the table
            </p>

            <!-- What's included -->
            <div class="pt-4 space-y-3" style="border-top: 1px solid #2D2D2D;">
              <p class="text-xs font-bold uppercase tracking-wider" style="color: #9A9A9A;">
                Included
              </p>
              {tierInfo.features.map((item) => (
                <div class="flex items-start gap-2">
                  <svg class="w-4 h-4 mt-0.5 flex-shrink-0" style="color: #CFB53B;" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-sm" style="color: #BEBEBE;">{item}</span>
                </div>
              ))}
            </div>

            <!-- Trust signals -->
            <div
              class="mt-6 pt-4 space-y-3"
              style="border-top: 1px solid #2D2D2D;"
            >
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" style="color: #059669;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span class="text-xs" style="color: #9A9A9A;">
                  Secure checkout powered by Stripe
                </span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-xs" style="color: #9A9A9A;">
                  7-day money-back guarantee
                </span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span class="text-xs" style="color: #9A9A9A;">
                  Instant access after payment
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT: Checkout + Reviews -->
        <div class="lg:col-span-3 order-1 lg:order-2">
          <h1 class="text-white text-xl font-bold mb-4">Complete your purchase</h1>
          <div class="mb-6">
            <UrgencyTimer client:load />
          </div>
          <CustomMasterclassCheckout client:load />

          <!-- Social proof reviews -->
          <div class="mt-8 space-y-4">
            <div
              class="rounded-xl p-5"
              style="background: #111; border: 1px solid #2D2D2D;"
            >
              <div class="flex items-center gap-1 mb-2">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-4 h-4" style="color: #CFB53B;" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-sm text-white leading-relaxed">
                "Finally someone who actually explains the math instead of selling a 'system.' The bankroll management section alone changed how I approach every session. I went from losing $500/month to being up consistently. Paid for itself on the first trip."
              </p>
              <p class="text-xs mt-2" style="color: #6B6B6B;">Marcus T. &mdash; Verified Buyer</p>
            </div>

            <div
              class="rounded-xl p-5"
              style="background: #111; border: 1px solid #2D2D2D;"
            >
              <div class="flex items-center gap-1 mb-2">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-4 h-4" style="color: #CFB53B;" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-sm text-white leading-relaxed">
                "I was skeptical because of all the haters online. But this is legit. Mikki breaks down exactly how casinos manipulate you and how to think like a professional. The module on casino psychology opened my eyes. Best investment I've made for the tables."
              </p>
              <p class="text-xs mt-2" style="color: #6B6B6B;">Daniel K. &mdash; Verified Buyer</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <Footer />

</BaseLayout>
