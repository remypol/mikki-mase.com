---
/**
 * Masterclass Success Page (Thank You)
 *
 * Instant gratification: celebration, what they got, what to do next.
 */

export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getStripeServer } from '../../lib/stripe';
import { generateDownloadToken, getDownloadUrl } from '../../lib/downloads';
import { sessionPlaybook } from '../../config/shop/products';

const sessionId = Astro.url.searchParams.get('session_id');

let verified = false;
let customerEmail: string | null = null;
let maskedEmail = '';
let metadataUserId = '';
let isGuestCheckout = false;
let error: string | null = null;
let purchaseAmount = sessionPlaybook.price;
let cheatsheetUrl = '';
let ebookUrl = '';

if (!sessionId) {
  error = 'No session ID provided';
} else {
  try {
    const stripe = await getStripeServer();
    const session = await stripe.checkout.sessions.retrieve(sessionId, {
      expand: ['line_items', 'customer_details'],
    });

    if (session.payment_status === 'paid') {
      verified = true;
      customerEmail = session.customer_details?.email || null;
      metadataUserId = session.metadata?.userId || '';
      isGuestCheckout = session.metadata?.isGuestCheckout === 'true' || !metadataUserId;
      purchaseAmount = (session.amount_total || 2700) / 100;

      if (customerEmail) {
        const [localPart, domain] = customerEmail.split('@');
        if (localPart && domain) {
          const visible = localPart.length <= 2 ? localPart[0] : localPart.slice(0, 2);
          maskedEmail = `${visible}${'*'.repeat(Math.max(localPart.length - 2, 1))}@${domain}`;
        }

        // Generate bonus download links
        const csToken = generateDownloadToken('mmc-cheatsheet-bundle', customerEmail, sessionId);
        const ebToken = generateDownloadToken('beat-the-casino', customerEmail, sessionId);
        cheatsheetUrl = getDownloadUrl(csToken);
        ebookUrl = getDownloadUrl(ebToken);
      }
    } else {
      error = 'Payment has not been completed yet.';
    }
  } catch (e) {
    console.error('Error retrieving session:', e);
    error = 'Unable to verify payment.';
  }
}
---

<BaseLayout
  title="You're In! | Mikki Mase Masterclass"
  description="Purchase confirmed. Welcome to the Masterclass."
  noIndex={true}
  hideMobileNav={true}
  hideBackToTop={true}
>
  <Header />

  <main id="main-content" class="min-h-screen" style="background: #0A0A0A;">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 py-12 md:py-20">

      {error ? (
        <!-- Error State -->
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center" style="background: rgba(220, 38, 38, 0.2);">
            <svg class="w-8 h-8" style="color: #FCA5A5;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-white mb-4">Something went wrong</h1>
          <p class="mb-8" style="color: #9A9A9A;">{error}</p>
          <a href="/masterclass" class="inline-block font-semibold px-6 py-3 rounded-lg" style="background: #CFB53B; color: #000;">
            Return to Course
          </a>
        </div>

      ) : (
        <!-- Success State -->
        <div>

          <!-- Celebration Header -->
          <div class="text-center mb-10">
            <div class="w-20 h-20 mx-auto mb-6 rounded-full flex items-center justify-center animate-scale" style="background: rgba(207, 181, 59, 0.2);">
              <svg class="w-10 h-10" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>

            <h1 class="text-3xl md:text-4xl font-black text-white mb-3">You're in!</h1>
            <p class="text-lg mb-1" style="color: #CFB53B; font-weight: 700;">Welcome to The Mikki Mase Masterclass</p>
            <p class="text-sm" style="color: #9A9A9A;">You just made the smartest bet of the day.</p>
          </div>

          <!-- What You Got -->
          <div class="rounded-2xl p-6 mb-8" style="background: #111; border: 1px solid #2D2D2D;">
            <h2 class="text-sm font-bold uppercase tracking-wider mb-4" style="color: #CFB53B;">What's Included</h2>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5" style="color: #22c55e;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <div>
                  <p class="text-white font-semibold text-sm">10-Module Masterclass</p>
                  <p class="text-xs" style="color: #9A9A9A;">25+ lessons, quizzes, interactive scenarios</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5" style="color: #22c55e;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <div>
                  <p class="text-white font-semibold text-sm">Cheatsheet Bundle</p>
                  <p class="text-xs" style="color: #9A9A9A;">Baccarat, Poker & Roulette strategy cards (PDF)</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5" style="color: #22c55e;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <div>
                  <p class="text-white font-semibold text-sm">Beat the Casino Ebook</p>
                  <p class="text-xs" style="color: #9A9A9A;">98-page guide to casino psychology & advantage play</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 flex-shrink-0 mt-0.5" style="color: #22c55e;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <div>
                  <p class="text-white font-semibold text-sm">Lifetime Access</p>
                  <p class="text-xs" style="color: #9A9A9A;">All future updates included, no subscription</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Access / Next Steps -->
          {isGuestCheckout ? (
            <div class="rounded-2xl p-6 mb-8" style="background: rgba(207, 181, 59, 0.06); border: 1px solid rgba(207, 181, 59, 0.25);">
              <div class="flex items-start gap-3 mb-4">
                <svg class="w-6 h-6 flex-shrink-0 mt-0.5" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <div>
                  <p class="text-white font-bold text-sm mb-1">Check your email to get started</p>
                  <p class="text-xs" style="color: #BEBEBE;">
                    We sent a <strong class="text-white">one-click login link</strong> to <strong class="text-white">{maskedEmail || 'your email'}</strong>. Click it to access everything instantly.
                  </p>
                </div>
              </div>
              <div class="text-xs" style="color: #6B6B6B;">
                Don't see it? Check your spam folder or <a href="mailto:support@mikki-mase.com" style="color: #CFB53B;">contact support</a>.
              </div>
            </div>
          ) : (
            <div class="text-center mb-8">
              <a
                href="/masterclass/course"
                class="inline-flex items-center justify-center gap-2 font-bold text-black min-h-[52px] rounded-xl px-10 text-lg transition-all hover:brightness-110 active:scale-[0.98]"
                style="background-color: #CFB53B;"
              >
                Start the Masterclass
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
              <p class="text-xs mt-3" style="color: #6B6B6B;">Module 1 is unlocked and ready to go.</p>
            </div>
          )}

          <!-- Bonus Downloads (immediate value) -->
          {(cheatsheetUrl || ebookUrl) && (
            <div class="rounded-2xl p-6 mb-8" style="background: #111; border: 1px solid #2D2D2D;">
              <h2 class="text-sm font-bold uppercase tracking-wider mb-4" style="color: #CFB53B;">Your Bonus Downloads</h2>
              <p class="text-xs mb-4" style="color: #9A9A9A;">Download these now — they're yours to keep forever.</p>
              <div class="space-y-3">
                {cheatsheetUrl && (
                  <a
                    href={cheatsheetUrl}
                    class="flex items-center gap-3 p-3 rounded-lg transition-colors hover:bg-white/5"
                    style="border: 1px solid #2D2D2D;"
                  >
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(207, 181, 59, 0.1);">
                      <svg class="w-5 h-5" style="color: #CFB53B;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-white text-sm font-semibold">MMC Cheatsheet Bundle</p>
                      <p class="text-xs" style="color: #6B6B6B;">Baccarat, Poker & Roulette — PDF</p>
                    </div>
                    <span class="text-xs font-bold" style="color: #CFB53B;">Download</span>
                  </a>
                )}
                {ebookUrl && (
                  <a
                    href={ebookUrl}
                    class="flex items-center gap-3 p-3 rounded-lg transition-colors hover:bg-white/5"
                    style="border: 1px solid #2D2D2D;"
                  >
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(207, 181, 59, 0.1);">
                      <svg class="w-5 h-5" style="color: #CFB53B;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-white text-sm font-semibold">Beat the Casino Ebook</p>
                      <p class="text-xs" style="color: #6B6B6B;">98 pages — PDF</p>
                    </div>
                    <span class="text-xs font-bold" style="color: #CFB53B;">Download</span>
                  </a>
                )}
              </div>
              <p class="text-xs mt-3" style="color: #6B6B6B;">Links expire in 7 days. You can re-download from your course dashboard.</p>
            </div>
          )}

          <!-- What's Next -->
          <div class="rounded-2xl p-6 mb-8" style="background: #111; border: 1px solid #2D2D2D;">
            <h2 class="text-sm font-bold uppercase tracking-wider mb-4" style="color: #CFB53B;">What to Do Next</h2>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold" style="background: rgba(207, 181, 59, 0.15); color: #CFB53B;">1</div>
                <div>
                  <p class="text-white text-sm font-semibold">Start with Module 1: Mindset & Disclaimer</p>
                  <p class="text-xs" style="color: #9A9A9A;">Sets the foundation — takes about 15 minutes.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold" style="background: rgba(207, 181, 59, 0.15); color: #CFB53B;">2</div>
                <div>
                  <p class="text-white text-sm font-semibold">Download your cheatsheets</p>
                  <p class="text-xs" style="color: #9A9A9A;">Print them or save to your phone for your next session.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold" style="background: rgba(207, 181, 59, 0.15); color: #CFB53B;">3</div>
                <div>
                  <p class="text-white text-sm font-semibold">Take the quizzes</p>
                  <p class="text-xs" style="color: #9A9A9A;">Test your understanding after each module.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Inner Circle Soft Mention -->
          <div class="rounded-2xl p-5 mb-8" style="background: rgba(207, 181, 59, 0.04); border: 1px solid rgba(207, 181, 59, 0.15);">
            <p class="text-sm mb-1" style="color: #BEBEBE;">
              <strong class="text-white">Want more?</strong> Inner Circle members get unlimited calculator tools, AI strategy advisor, community access, and monthly updates.
            </p>
            <a href="/masterclass/course" class="text-xs font-semibold" style="color: #CFB53B; text-decoration: none;">
              Learn more inside your dashboard →
            </a>
          </div>

          <!-- Trust Footer -->
          <div class="text-center space-y-3">
            <div class="flex items-center justify-center gap-4 text-xs" style="color: #6B6B6B;">
              <span>Secure checkout via Stripe</span>
              <span>|</span>
              <span>7-day money-back guarantee</span>
            </div>
            <p class="text-xs" style="color: #6B6B6B;">
              Questions? <a href="mailto:support@mikki-mase.com" style="color: #CFB53B;">support@mikki-mase.com</a>
            </p>
            <p class="text-xs" style="color: #4A4A4A;">For educational purposes only. No guarantee of winnings.</p>
          </div>

        </div>
      )}

    </div>
  </main>

  <Footer />
</BaseLayout>

<!-- GA4: Purchase event tracking -->
{verified && sessionId && (
  <script
    is:inline
    define:vars={{
      transactionId: sessionId,
      ga4ProductId: sessionPlaybook.id,
      ga4ProductName: sessionPlaybook.name,
      ga4ProductPrice: purchaseAmount,
    }}
  >
    document.addEventListener('astro:page-load', function() {
      var trackedKey = 'purchase_tracked_' + transactionId;
      if (sessionStorage.getItem(trackedKey)) return;

      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      gtag('event', 'purchase', {
        transaction_id: transactionId,
        value: ga4ProductPrice,
        currency: 'USD',
        items: [{
          item_id: ga4ProductId,
          item_name: ga4ProductName,
          price: ga4ProductPrice,
          quantity: 1
        }]
      });

      sessionStorage.setItem(trackedKey, 'true');
    });
  </script>
)}

<style>
  @keyframes scale {
    0% { transform: scale(0); opacity: 0; }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); opacity: 1; }
  }
  .animate-scale {
    animation: scale 0.5s ease-out;
  }
</style>
