---
/**
 * Masterclass Success Page (Thank You)
 *
 * Shows purchase confirmation with course access link.
 */

export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getStripeServer } from '../../lib/stripe';
import { getServerClient } from '../../lib/supabase';
import { sessionPlaybook } from '../../config/shop/products';

const sessionId = Astro.url.searchParams.get('session_id');

let verified = false;
let customerEmail: string | null = null;
let maskedEmail = '';
let metadataUserId = '';
let isGuestCheckout = false;
let error: string | null = null;
let purchaseAmount = sessionPlaybook.price;

if (!sessionId) {
  error = 'No session ID provided';
} else {
  try {
    const stripe = await getStripeServer();
    const session = await stripe.checkout.sessions.retrieve(sessionId, {
      expand: ['line_items', 'customer_details'],
    });

    if (session.payment_status === 'paid') {
      verified = true;
      customerEmail = session.customer_details?.email || null;
      metadataUserId = session.metadata?.userId || '';
      isGuestCheckout = session.metadata?.isGuestCheckout === 'true' || !metadataUserId;
      purchaseAmount = (session.amount_total || 2700) / 100;

      if (customerEmail) {
        const [localPart, domain] = customerEmail.split('@');
        if (localPart && domain) {
          const visible = localPart.length <= 2 ? localPart[0] : localPart.slice(0, 2);
          maskedEmail = `${visible}${'*'.repeat(Math.max(localPart.length - 2, 1))}@${domain}`;
        }
      }
    } else {
      error = 'Payment has not been completed yet.';
    }
  } catch (e) {
    console.error('Error retrieving session:', e);
    error = 'Unable to verify payment.';
  }
}
---

<BaseLayout
  title="Your Masterclass is Ready! | Mikki Mase"
  description="Purchase confirmed. Access your Masterclass."
  noIndex={true}
  hideMobileNav={true}
  hideBackToTop={true}
>
  <Header />

  <main id="main-content" class="min-h-screen" style="background: #0A0A0A;">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 py-12 md:py-20">

      {error ? (
        <!-- Error State -->
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center" style="background: rgba(220, 38, 38, 0.2);">
            <svg class="w-8 h-8" style="color: #FCA5A5;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-white mb-4">Something went wrong</h1>
          <p class="mb-8" style="color: #9A9A9A;">{error}</p>
          <a
            href="/masterclass"
            class="inline-block font-semibold px-6 py-3 rounded-lg transition-colors"
            style="background: #CFB53B; color: #000;"
          >
            Return to Course
          </a>
        </div>

      ) : (
        <!-- Success State -->
        <div>

          <!-- Confirmation -->
          <div class="text-center mb-12">
            <div class="w-20 h-20 mx-auto mb-6 rounded-full flex items-center justify-center animate-scale" style="background: rgba(207, 181, 59, 0.2);">
              <svg class="w-10 h-10" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>

            <h1 class="text-3xl font-bold text-white mb-2">Your Masterclass is ready!</h1>
            <p class="text-lg mb-4" style="color: #CFB53B;">Purchase confirmed</p>

            {isGuestCheckout ? (
              <div
                class="rounded-xl p-5 text-left mb-6 max-w-md mx-auto"
                style="background: rgba(207, 181, 59, 0.08); border: 1px solid rgba(207, 181, 59, 0.25);"
              >
                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 flex-shrink-0 mt-0.5" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <div>
                    <p class="text-white font-bold text-sm mb-1">Check your email to access the Masterclass</p>
                    <p class="text-xs" style="color: #BEBEBE;">
                      We sent a <strong class="text-white">one-click login link</strong> to <strong class="text-white">{maskedEmail || 'your email'}</strong>.
                    </p>
                  </div>
                </div>
              </div>
            ) : (
              <a
                href="/masterclass/course"
                class="inline-flex items-center justify-center gap-2 font-bold text-black min-h-[48px] rounded-xl px-8 transition-all hover:brightness-110 active:scale-[0.98] mb-6"
                style="background-color: #CFB53B;"
              >
                Access Your Masterclass
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            )}
          </div>

          <!-- Inner Circle mention -->
          <div style="margin-top: 2rem; padding: 1.5rem; background: #111; border: 1px solid #1A1A1A; border-radius: 12px;">
            <p style="color: #BEBEBE; font-size: 14px; margin: 0;">
              Want unlimited calculator tools, AI strategy advisor, and community access?
            </p>
            <a href="/masterclass/course" style="color: #CFB53B; font-size: 14px; font-weight: 600; text-decoration: none;">
              Explore the Inner Circle →
            </a>
          </div>

          <!-- Trust / Disclaimer -->
          <div class="text-center space-y-3">
            <div class="flex items-center justify-center gap-4 text-xs" style="color: #6B6B6B;">
              <span>Secure checkout via Stripe</span>
              <span>|</span>
              <span>7-day guarantee</span>
              <span>|</span>
              <span>Educational content only</span>
            </div>
            <p class="text-sm" style="color: #6B6B6B;">
              Questions? <a href="mailto:support@mikki-mase.com" class="hover:underline" style="color: #CFB53B;">Contact support</a>
            </p>
          </div>

        </div>
      )}

    </div>
  </main>

  <Footer />
</BaseLayout>

<!-- GA4: Purchase event tracking -->
{verified && sessionId && (
  <script
    is:inline
    define:vars={{
      transactionId: sessionId,
      ga4ProductId: sessionPlaybook.id,
      ga4ProductName: sessionPlaybook.name,
      ga4ProductPrice: purchaseAmount,
    }}
  >
    document.addEventListener('astro:page-load', function() {
      var trackedKey = 'purchase_tracked_' + transactionId;
      if (sessionStorage.getItem(trackedKey)) return;

      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      gtag('event', 'purchase', {
        transaction_id: transactionId,
        value: ga4ProductPrice,
        currency: 'USD',
        items: [{
          item_id: ga4ProductId,
          item_name: ga4ProductName,
          price: ga4ProductPrice,
          quantity: 1
        }]
      });

      sessionStorage.setItem(trackedKey, 'true');
    });
  </script>
)}

<style>
  @keyframes scale {
    0% { transform: scale(0); opacity: 0; }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); opacity: 1; }
  }
  .animate-scale {
    animation: scale 0.5s ease-out;
  }
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin {
    animation: spin 1s linear infinite;
  }
</style>
