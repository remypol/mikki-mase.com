---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SupportChat from '../components/SupportChat.tsx';
---

<BaseLayout
  title="Support — Mikki Mase"
  description="Get help with your account or any questions. AI-powered instant answers or email our support team."
>
  <Header />

  <main id="main-content" class="pt-24 pb-20">
    <div class="container max-w-3xl mx-auto px-4">
      <!-- Heading -->
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-black uppercase mb-4">Support</h1>
        <p class="text-tertiary text-lg max-w-md mx-auto">
          Ask our AI assistant or send us a message. We're here to help.
        </p>
      </div>

      <!-- Chat / Form Widget -->
      <SupportChat client:load />

      <!-- Additional Help -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-6 text-center">
        <a href="/faq" class="block p-6 rounded-xl bg-card border border-subtle hover:border-gold/30 hover:-translate-y-0.5 transition-all group">
          <div class="text-2xl mb-3">?</div>
          <h3 class="text-white font-bold mb-1 group-hover:text-gold transition-colors">FAQ</h3>
          <p class="text-tertiary text-sm">Browse common questions</p>
        </a>

        <a href="/join" class="block p-6 rounded-xl bg-card border border-subtle hover:border-gold/30 hover:-translate-y-0.5 transition-all group">
          <div class="text-2xl mb-3">
            <svg class="w-6 h-6 mx-auto text-gold" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27-.02-.12.02-1.96 1.25-5.54 3.67-.52.36-1 .53-1.42.52-.47-.01-1.37-.26-2.03-.48-.82-.27-1.47-.42-1.42-.88.03-.24.37-.49 1.02-.75 3.98-1.73 6.63-2.87 7.95-3.44 3.79-1.58 4.58-1.86 5.09-1.87.11 0 .37.03.53.14.14.1.18.23.2.33.02.1.04.31.02.49z"/>
            </svg>
          </div>
          <h3 class="text-white font-bold mb-1 group-hover:text-gold transition-colors">Fan Community</h3>
          <p class="text-tertiary text-sm">Join the Mikki Mase Fan Community</p>
        </a>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
