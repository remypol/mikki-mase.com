---
/**
 * AI Casino Strategy Advisor Page
 * Tier-gated: Inner Circle + Lifetime VIP only
 */
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import AICasinoAdvisor from '../../../components/AICasinoAdvisor';
import { hasInnerCircleAccess, hasVipAccess } from '../../../lib/tiers';

const tier = Astro.locals.tier || 'masterclass';

// Gate: only Inner Circle and VIP
if (!hasInnerCircleAccess(tier)) {
  return Astro.redirect('/masterclass/course?upgrade=inner-circle');
}

const isVip = hasVipAccess(tier);
---

<BaseLayout
  title="AI Casino Strategy Advisor | Mikki Mase Masterclass"
  description="Get instant answers to any casino strategy question, powered by AI."
  noIndex={true}
>
  <Header />

  <main class="min-h-screen pt-24 pb-12 px-4" style="background: #000;">
    <div class="max-w-2xl mx-auto mb-6">
      <a
        href="/masterclass/course"
        class="inline-flex items-center gap-1.5 text-sm transition-colors hover:text-white"
        style="color: #6B6B6B;"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Course
      </a>
    </div>

    <AICasinoAdvisor client:load isVip={isVip} />
  </main>

  <Footer />
</BaseLayout>
