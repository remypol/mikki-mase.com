---
/**
 * Daily Drops — Community Feed Page
 * Protected: requires auth + masterclass purchase (via middleware)
 */
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { DailyDropsFeed } from '../../../components/daily-drops/DailyDropsFeed';

// Set cache headers for protected page
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
---

<BaseLayout
  title="Daily Drops | Mikki Mase Masterclass"
  description="Daily knowledge bombs from Mikki Mase. Fresh casino insights, strategies, and community discussions."
  noIndex={true}
>
  <Header />

  <main class="min-h-screen py-8 px-4" style="background: #000;">
    {/* Back to course link */}
    <div class="max-w-2xl mx-auto mb-4">
      <a
        href="/masterclass/course"
        class="inline-flex items-center gap-1.5 text-sm transition-colors hover:text-white"
        style="color: #9A9A9A;"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Course
      </a>
    </div>

    <DailyDropsFeed client:load />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hide scrollbar for category filter */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
