---
/**
 * The Inner Circle — Members-only community feed
 * Protected: requires auth + Inner Circle or Lifetime VIP tier (via middleware)
 * Masterclass-only users are redirected to course dashboard with upgrade prompt.
 */
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { DailyDropsFeed } from '../../../components/daily-drops/DailyDropsFeed';
import { hasInnerCircleAccess } from '../../../lib/tiers';

// Tier gating: only Inner Circle and Lifetime VIP can access daily drops
const tier = Astro.locals.tier;
if (!tier || !hasInnerCircleAccess(tier)) {
  return Astro.redirect('/masterclass/course?upgrade=inner-circle');
}

// Set cache headers for protected page
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
---

<BaseLayout
  title="The Inner Circle | Mikki Mase Masterclass"
  description="Exclusive updates from Mikki's team. Strategy breakdowns, mindset drops, and insider knowledge for masterclass members."
  noIndex={true}
>
  <Header />

  <main class="min-h-screen pt-24 pb-12 px-4" style="background: #000;">
    {/* Back to course link */}
    <div class="max-w-2xl mx-auto mb-6">
      <a
        href="/masterclass/course"
        class="inline-flex items-center gap-1.5 text-sm transition-colors hover:text-white"
        style="color: #6B6B6B;"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Course
      </a>
    </div>

    <DailyDropsFeed client:load />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hide scrollbar for category filter */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
