---
/**
 * Course Dashboard — SSR (server-rendered, protected by middleware)
 * Middleware handles auth + purchase verification before this page loads.
 */
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PasswordGate from '../../../components/PasswordGate.astro';
import { courseManifest } from '../../../config/course/manifest';
import { generateDownloadToken } from '../../../lib/downloads';
import { hasInnerCircleAccess, hasVipAccess, TIER_LABELS, type UserTier } from '../../../lib/tiers';

// User info from middleware (set by src/middleware.ts)
const user = Astro.locals.user;
const userEmail = user?.email || '';
const tier: UserTier = Astro.locals.tier || 'masterclass';
const isInnerCircle = hasInnerCircleAccess(tier);
const isVip = hasVipAccess(tier);

// Check for upgrade prompt (redirected from daily-drops)
const upgradePrompt = Astro.url.searchParams.get('upgrade');

// Generate bonus download links for purchased users
let cheatsheetDownloadUrl = '';
let ebookDownloadUrl = '';
if (Astro.locals.hasMasterclass && userEmail) {
  const cheatsheetToken = generateDownloadToken('mmc-cheatsheet-bundle', userEmail, 'dashboard');
  const ebookToken = generateDownloadToken('beat-the-casino', userEmail, 'dashboard');
  cheatsheetDownloadUrl = `/download/${cheatsheetToken}`;
  ebookDownloadUrl = `/download/${ebookToken}`;
}

// Set cache headers for protected content
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
---

<BaseLayout
  title="Course Dashboard | The Mikki Mase Masterclass"
  description="Your Masterclass dashboard. Track progress across 10 modules, 30+ lessons, and interactive scenarios."
  noIndex={true}
  hideMobileNav={true}
>
  <PasswordGate>
  <Header />
  <!-- PasswordGate stays for dev; middleware handles real auth -->

  <main id="main-content" class="min-h-screen bg-black pt-20 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Header -->
      <div class="mb-10 text-center">
        <span class="text-xs font-bold uppercase tracking-widest" style="color: #CFB53B;">
          The Mikki Mase Masterclass
        </span>
        <h1 class="text-4xl md:text-5xl font-black text-white mt-3 mb-3">Course Dashboard</h1>
        <p class="text-sm" style="color: #9A9A9A;">
          {courseManifest.modules.length} modules &middot; {courseManifest.estimatedHours} hours &middot; Interactive scenarios
        </p>
      </div>

      <!-- Tier badge -->
      {isVip && (
        <div class="flex items-center justify-center gap-2 mb-6 px-4 py-2 rounded-full mx-auto w-fit" style="background: rgba(207, 181, 59, 0.1); border: 1px solid rgba(207, 181, 59, 0.25);">
          <span style="font-size: 16px;">&#x1F451;</span>
          <span class="text-xs font-bold uppercase tracking-wider" style="color: #CFB53B;">Founding Member — Lifetime VIP</span>
        </div>
      )}

      <!-- Upgrade prompt (shown when redirected from gated feature) -->
      {upgradePrompt && (
        <div class="mb-6 px-4 py-3 rounded-xl text-sm" style="background: rgba(207, 181, 59, 0.08); border: 1px solid rgba(207, 181, 59, 0.2);">
          <p class="text-white font-medium">The Inner Circle is exclusive to Inner Circle & Lifetime VIP members.</p>
          <p class="text-xs mt-1" style="color: #BEBEBE;">
            Upgrade to get daily strategy drops, AI advisor, and community access.
            <a href="/masterclass#pricing" class="font-bold underline" style="color: #CFB53B;">See plans</a>
          </p>
        </div>
      )}

      <!-- The Inner Circle section — different for each tier -->
      {isInnerCircle ? (
        <!-- Inner Circle / VIP: link to daily drops -->
        <a
          href="/masterclass/course/daily-drops"
          class="block p-5 rounded-xl border transition-all duration-200 hover:border-[#CFB53B]/50 group mb-8"
          style="background: linear-gradient(135deg, rgba(207, 181, 59, 0.06) 0%, #1A1A1A 100%); border-color: rgba(207, 181, 59, 0.3);"
        >
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full overflow-hidden flex-shrink-0 ring-2 ring-[#CFB53B]/30">
              <img src="/images/mikki-avatar.jpg" alt="Mikki Mase" class="w-full h-full object-cover" />
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-0.5">
                <h2 class="text-lg font-bold text-white group-hover:text-[#CFB53B] transition-colors">
                  The Inner Circle
                </h2>
                <span class="text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded" style="background-color: rgba(207, 181, 59, 0.15); color: #CFB53B;">
                  LIVE
                </span>
              </div>
              <p class="text-sm" style="color: #BEBEBE;">
                Exclusive strategy breakdowns, updates & real talk from Mikki's team. Join the conversation.
              </p>
            </div>
            <svg class="w-5 h-5 flex-shrink-0 text-[#CFB53B] group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ) : (
        <!-- Masterclass only: upsell to Inner Circle -->
        <div
          class="p-5 rounded-xl border mb-8 relative overflow-hidden"
          style="background: #1A1A1A; border-color: #2D2D2D;"
        >
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full overflow-hidden flex-shrink-0 opacity-50">
              <img src="/images/mikki-avatar.jpg" alt="Mikki Mase" class="w-full h-full object-cover" />
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-0.5">
                <h2 class="text-lg font-bold" style="color: #6B6B6B;">
                  The Inner Circle
                </h2>
                <span class="text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded" style="background-color: rgba(255,255,255,0.05); color: #6B6B6B;">
                  LOCKED
                </span>
              </div>
              <p class="text-sm" style="color: #6B6B6B;">
                Daily strategy drops, community feed, AI advisor & more.
              </p>
              <a
                href="/masterclass#pricing"
                class="inline-flex items-center gap-1.5 text-xs font-bold mt-2 transition-colors hover:brightness-110"
                style="color: #CFB53B;"
              >
                Upgrade to Inner Circle
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      )}

      <!-- AI Casino Strategy Advisor -->
      {isInnerCircle ? (
        <div
          class="p-5 rounded-xl border mb-8 transition-all duration-200 hover:border-[#CFB53B]/50"
          style="background: #1A1A1A; border-color: rgba(207, 181, 59, 0.2);"
        >
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(207, 181, 59, 0.1);">
              <span style="font-size: 18px;">&#x1F916;</span>
            </div>
            <div>
              <h3 class="text-sm font-bold text-white">AI Casino Strategy Advisor</h3>
              <p class="text-xs" style="color: #9A9A9A;">
                {isVip ? 'Unlimited questions — Priority' : '20 questions per day'}
              </p>
            </div>
          </div>
          <p class="text-xs mb-3" style="color: #BEBEBE;">
            Ask anything about casino strategy. Get answers based on Mikki's proven system.
          </p>
          <a
            href="/masterclass/course/ai-advisor"
            class="inline-flex items-center gap-1.5 text-xs font-bold transition-colors hover:brightness-110"
            style="color: #CFB53B;"
          >
            Open AI Advisor
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
      ) : (
        <div
          class="p-5 rounded-xl border mb-8"
          style="background: #1A1A1A; border-color: #2D2D2D;"
        >
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center opacity-50" style="background: rgba(255,255,255,0.05);">
              <span style="font-size: 18px;">&#x1F916;</span>
            </div>
            <div>
              <h3 class="text-sm font-bold" style="color: #6B6B6B;">AI Casino Strategy Advisor</h3>
              <span class="text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded" style="background-color: rgba(255,255,255,0.05); color: #6B6B6B;">LOCKED</span>
            </div>
          </div>
          <p class="text-xs mb-2" style="color: #6B6B6B;">
            Get instant answers to any casino strategy question, powered by AI.
          </p>
          <a href="/masterclass#pricing" class="inline-flex items-center gap-1.5 text-xs font-bold" style="color: #CFB53B;">
            Upgrade to unlock
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
      )}

      <!-- Module Grid -->
      <div class="space-y-4">
        {courseManifest.modules.map((mod) => (
          <a
            href={`/masterclass/course/${mod.slug}/${mod.lessons[0].slug}`}
            class="block p-6 rounded-xl border transition-all duration-200 hover:border-[#CFB53B]/50 hover:bg-white/[0.02] group"
            style={`background-color: #1A1A1A; border-color: #2D2D2D;`}
          >
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0" style="background-color: rgba(207, 181, 59, 0.1); border: 1px solid rgba(207, 181, 59, 0.2);">
                <span class="text-sm font-black" style="color: #CFB53B;">{String(mod.number).padStart(2, '0')}</span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-[10px] font-bold uppercase tracking-wider" style="color: #9A9A9A;">
                    Module {mod.number}
                  </span>
                  {mod.isFreePreview && (
                    <span
                      class="text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded"
                      style="background-color: rgba(207, 181, 59, 0.15); color: #CFB53B;"
                    >
                      Free Preview
                    </span>
                  )}
                </div>
                <h2 class="text-lg font-bold text-white group-hover:text-[#CFB53B] transition-colors">
                  {mod.title}
                </h2>
                <p class="text-sm mt-1" style="color: #BEBEBE;">{mod.description}</p>
                <div class="flex items-center gap-4 mt-3">
                  <span class="text-xs" style="color: #9A9A9A;">
                    {mod.lessons.length} lessons
                  </span>
                  {mod.hasQuiz && (
                    <span class="text-xs" style="color: #9A9A9A;">Quiz</span>
                  )}
                  {mod.scenarios && mod.scenarios.length > 0 && (
                    <span class="text-xs" style="color: #CFB53B;">Interactive</span>
                  )}
                </div>
              </div>
              <svg class="w-5 h-5 flex-shrink-0 mt-2 text-[#9A9A9A] group-hover:text-[#CFB53B] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>

      <!-- Bonus Downloads (for purchased users) -->
      {cheatsheetDownloadUrl && ebookDownloadUrl && (
        <div class="mt-12">
          <h2 class="text-lg font-bold text-white mb-4">Your Bonus Downloads</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            <a
              href={cheatsheetDownloadUrl}
              class="flex items-center gap-4 p-5 rounded-xl border transition-all duration-200 hover:border-[#CFB53B]/50 hover:bg-white/[0.02] group"
              style="background-color: #1A1A1A; border-color: #2D2D2D;"
            >
              <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(207, 181, 59, 0.1);">
                <svg class="w-5 h-5" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-bold text-white group-hover:text-[#CFB53B] transition-colors">MMC Cheatsheet Bundle</h3>
                <p class="text-xs" style="color: #9A9A9A;">Baccarat, Poker & Roulette strategy cards</p>
              </div>
            </a>

            <a
              href={ebookDownloadUrl}
              class="flex items-center gap-4 p-5 rounded-xl border transition-all duration-200 hover:border-[#CFB53B]/50 hover:bg-white/[0.02] group"
              style="background-color: #1A1A1A; border-color: #2D2D2D;"
            >
              <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(207, 181, 59, 0.1);">
                <svg class="w-5 h-5" style="color: #CFB53B;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-sm font-bold text-white group-hover:text-[#CFB53B] transition-colors">Beat the Casino Ebook</h3>
                <p class="text-xs" style="color: #9A9A9A;">98-page guide to casino psychology & advantage play</p>
              </div>
            </a>
          </div>
        </div>
      )}
    </div>
  </main>

  <Footer />
  </PasswordGate>
</BaseLayout>
