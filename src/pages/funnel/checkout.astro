---
// Funnel killed (2026-07-16): fan page sells nothing — redirect to /join.
return Astro.redirect('/join', 301);

/**
 * FUNNEL CHECKOUT, Beat the Casino $27 + order-bump Cheat Sheet Pack $17
 *
 * Embedded Stripe Payment Element via FunnelCheckout. The bump checkbox
 * recreates the PaymentIntent server-side (front + bump = $44) and the
 * webhook delivers both PDFs. On success Stripe returns to OTO1.
 *
 * NON-DESTRUCTIVE: brand-new route under /funnel/*. Guest checkout supported;
 * no auth gate (these are impulse PDFs).
 */

export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import FunnelHeader from '../../components/FunnelHeader.astro';
import FunnelFooter from '../../components/FunnelFooter.astro';
import FunnelCheckout from '../../components/funnel/FunnelCheckout.tsx';
import { bfBeatTheCasino, bfCheatSheetPack } from '../../config/shop/products';

const GOLD = '#D4AF37';
const front = bfBeatTheCasino;
const bump = bfCheatSheetPack;

// On payment success, Stripe redirects to OTO1.
const successPath = '/funnel/upsell/advantage-vault';
---

<BaseLayout
  title={`Checkout | ${front.name}`}
  description="Complete your order. Instant PDF delivery to your email."
  noIndex={true}
  hideMobileNav={true}
  hideBackToTop={true}
  bareChrome={true}
>
  <FunnelHeader />

  <main id="main-content" class="min-h-screen" style="background: #0A0A0A;">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-16">

      <a
        href="/funnel/beat-the-casino"
        class="inline-flex items-center gap-2 text-sm mb-8 transition-colors hover:text-white"
        style="color: #6B6B6B;"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12">

        <!-- LEFT: Order summary -->
        <div class="lg:col-span-2 order-1">
          <div class="rounded-2xl p-6 lg:sticky lg:top-8" style="background: #111; border: 1px solid #2D2D2D;">
            <h2 class="text-xs font-bold uppercase tracking-widest mb-6" style={`color: ${GOLD};`}>
              Order Summary
            </h2>

            <div class="flex items-start gap-4 mb-5">
              <div
                class="w-14 h-14 rounded-lg flex items-center justify-center flex-shrink-0"
                style="background: rgba(212,175,55,0.1); border: 1px solid rgba(212,175,55,0.2);"
              >
                <svg class="w-7 h-7" style={`color: ${GOLD};`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
              <div>
                <h3 class="text-white font-bold text-sm">{front.name}</h3>
                <p class="text-xs mt-1" style="color: #9A9A9A;">One-time · Instant PDF</p>
              </div>
              <span class="ml-auto text-white font-bold text-sm">${front.price}</span>
            </div>

            <div class="py-3" style="border-top: 1px solid #2D2D2D;">
              <p class="text-xs leading-relaxed" style="color: #9A9A9A;">
                Add the <strong style="color:#fff;">{bump.name}</strong> on the right for just
                <strong style={`color:${GOLD};`}>${bump.price}</strong> and we'll bundle both downloads into one email.
              </p>
            </div>

            <div class="mt-4 pt-4 space-y-3" style="border-top: 1px solid #2D2D2D;">
              {[
                ['#22c55e', 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', 'Secure checkout powered by Stripe'],
                [GOLD, 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z', '7-day money-back guarantee'],
                [GOLD, 'M13 10V3L4 14h7v7l9-11h-7z', 'Instant download after payment'],
                ['#9A9A9A', 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253', 'For educational purposes only'],
              ].map(([color, d, label]) => (
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 flex-shrink-0" style={`color: ${color};`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={d} />
                  </svg>
                  <span class="text-xs" style="color: #9A9A9A;">{label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- RIGHT: Payment -->
        <div class="lg:col-span-3 order-2">
          <h1 class="text-white text-xl font-bold mb-2">Complete your order</h1>
          <p class="text-sm mb-8" style="color: #9A9A9A;">
            Secure payment, your card details never touch our servers.
          </p>

          <FunnelCheckout
            client:load
            tier={front.id}
            price={front.price}
            successPath={successPath}
            bump={{
              label: bump.name,
              description: bump.description,
              price: bump.price,
            }}
          />

          <div class="mt-8 rounded-lg p-4" style="background: rgba(255,255,255,0.02); border: 1px solid #1A1A1A;">
            <p class="text-[11px] leading-relaxed" style="color: #4A4A4A;">
              <strong style="color: #6B6B6B;">Disclaimer:</strong> Educational and entertainment purposes only. Gambling
              involves risk and you may lose money. No guarantee of winnings. 18+ (21+ in most US jurisdictions). Gamble
              responsibly, help at 1-800-522-4700. By purchasing you agree to our
              <a href="/terms" class="underline" style="color: #6B6B6B;">Terms</a> and
              <a href="/privacy-policy" class="underline" style="color: #6B6B6B;">Privacy Policy</a>.
            </p>
          </div>
        </div>

      </div>
    </div>
  </main>

  <FunnelFooter />
</BaseLayout>
