---
/**
 * FUNNEL FRONT SALES PAGE, Beat the Casino (High-Roller Edition) $27
 *
 * Part of the new all-PDF funnel under /funnel/*. Self-contained, premium
 * black + gold (#D4AF37). Pulls copy from the bfBeatTheCasino product object.
 * Routes to /funnel/checkout (which carries the $17 cheat-sheet-pack bump).
 *
 * NON-DESTRUCTIVE: brand-new route. Does not touch the legacy
 * /beat-the-casino sales page or any existing product.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import FunnelHeader from '../../components/FunnelHeader.astro';
import FunnelFooter from '../../components/FunnelFooter.astro';
import { bfBeatTheCasino as product } from '../../config/shop/products';

const GOLD = '#D4AF37';
const sp = product.salesPage!;
const checkoutHref = '/funnel/checkout';

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    product.seo.schema,
    {
      '@type': 'FAQPage',
      mainEntity: sp.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title={product.seo.title}
  description={product.seo.description}
  ogImage={product.seo.image}
  schema={pageSchema}
  hideMobileNav={true}
  hideBackToTop={true}
  bareChrome={true}
>
  <FunnelHeader />

  <main id="main-content" style="background: #0A0A0A;">

    <!-- HERO / HOOK -->
    <section class="px-4 pt-16 pb-12 md:pt-24 md:pb-16" style="background-image: linear-gradient(rgba(10,10,10,0.72), rgba(10,10,10,0.93)), url('/images/funnel/hero-beat-the-casino.png'); background-size: cover; background-position: center;">
      <div class="max-w-3xl mx-auto text-center">
        <span
          class="inline-block px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest mb-6"
          style={`background: rgba(212,175,55,0.12); color: ${GOLD}; border: 1px solid rgba(212,175,55,0.3);`}
        >
          The High-Roller Edition
        </span>
        <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-5">
          {sp.headline}
        </h1>
        <p class="text-base md:text-lg leading-relaxed mb-8" style="color: #BEBEBE;">
          {sp.subheadline}
        </p>
        <div class="flex flex-col items-center gap-3">
          <a
            href={checkoutHref}
            class="inline-flex items-center justify-center gap-2 font-black min-h-[56px] rounded-xl px-10 text-lg transition-all hover:brightness-110 active:scale-[0.98]"
            style={`background: ${GOLD}; color: #000;`}
          >
            Send Me the Book, ${product.price}
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <p class="text-xs" style="color: #6B6B6B;">
            Instant PDF download · <span style="text-decoration: line-through;">${product.compareAt}</span> today ${product.price} · 7-day guarantee
          </p>
        </div>
      </div>
    </section>

    <!-- $32M CREDIBILITY STRIP -->
    <section class="px-4 py-6" style="border-top: 1px solid #1A1A1A; border-bottom: 1px solid #1A1A1A; background: #0C0C0C;">
      <div class="max-w-3xl mx-auto grid grid-cols-3 gap-4 text-center">
        <div>
          <p class="text-2xl md:text-3xl font-black" style={`color: ${GOLD};`}>$32M+</p>
          <p class="text-[11px] uppercase tracking-wider mt-1" style="color: #8A8A8A;">Won in casinos</p>
        </div>
        <div>
          <p class="text-2xl md:text-3xl font-black" style={`color: ${GOLD};`}>150+</p>
          <p class="text-[11px] uppercase tracking-wider mt-1" style="color: #8A8A8A;">Casino bans</p>
        </div>
        <div>
          <p class="text-2xl md:text-3xl font-black" style={`color: ${GOLD};`}>8</p>
          <p class="text-[11px] uppercase tracking-wider mt-1" style="color: #8A8A8A;">Chapters</p>
        </div>
      </div>
    </section>

    <!-- PAIN POINTS -->
    <section class="px-4 py-14 md:py-20">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black text-white text-center mb-10">
          This Is What's Really Happening to You
        </h2>
        <div class="space-y-3">
          {sp.painPoints.map((pain) => (
            <div class="flex items-center gap-4 rounded-xl p-5" style="background: #111; border: 1px solid #2D2D2D;">
              <div class="w-9 h-9 flex-shrink-0 rounded-full flex items-center justify-center" style="background: rgba(168,0,30,0.12);">
                <span style="color: #ff6b6b; font-size: 18px;">&#x2717;</span>
              </div>
              <p class="text-base" style="color: #D8D8D8;">{pain}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- THE SYSTEM (what's inside) -->
    <section class="px-4 py-14 md:py-20" style="background: #0C0C0C;">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-2xl md:text-3xl font-black text-white mb-3">The System, Chapter by Chapter</h2>
          <p class="text-sm md:text-base" style="color: #9A9A9A;">
            Not tricks. Not card-counting fantasies. A discipline pointed at the house.
          </p>
        </div>
        <div class="space-y-3">
          {sp.chapters.map((ch) => (
            <div class="flex items-start gap-4 rounded-xl p-5" style="background: #111; border: 1px solid #2D2D2D;">
              <div
                class="w-9 h-9 flex-shrink-0 rounded-lg flex items-center justify-center text-sm font-black"
                style={`background: rgba(212,175,55,0.1); color: ${GOLD}; border: 1px solid rgba(212,175,55,0.2);`}
              >
                {ch.number}
              </div>
              <div>
                <h3 class="text-white font-bold text-base mb-1">{ch.title}</h3>
                <p class="text-sm leading-relaxed" style="color: #9A9A9A;">{ch.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- THE OFFER -->
    <section class="px-4 py-16 md:py-24">
      <div class="max-w-md mx-auto">
        <div
          class="rounded-2xl p-7 md:p-8 text-center"
          style={`background: #111; border: 1px solid rgba(212,175,55,0.3); box-shadow: 0 0 60px rgba(212,175,55,0.08);`}
        >
          <h2 class="text-2xl font-black text-white mb-2">Beat the Casino</h2>
          <p class="text-sm mb-6" style={`color: ${GOLD};`}>{product.tagline}</p>

          <div class="flex items-center justify-center gap-3 mb-2">
            <span class="text-lg line-through" style="color: #6B6B6B;">${product.compareAt}</span>
            <span class="text-5xl font-black text-white">${product.price}</span>
          </div>
          <p class="text-xs mb-6" style="color: #9A9A9A;">One-time payment · Instant PDF · Yours forever</p>

          <div class="space-y-2.5 text-left mb-7">
            {[
              'All 8 chapters, psychology, discipline, bet sizing',
              "Mikki's 30-45 minute session strategy",
              'The win/loss-limit framework that protects your bankroll',
              'How to see, and beat, the comp trap',
              'Instant download, read on any device',
            ].map((f) => (
              <div class="flex items-start gap-2.5">
                <svg class="w-4 h-4 flex-shrink-0 mt-0.5" style={`color: ${GOLD};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-white">{f}</span>
              </div>
            ))}
          </div>

          <a
            href={checkoutHref}
            class="w-full inline-flex items-center justify-center gap-2 font-black min-h-[56px] rounded-xl px-8 text-lg transition-all hover:brightness-110 active:scale-[0.98]"
            style={`background: ${GOLD}; color: #000;`}
          >
            Get Instant Access, ${product.price}
          </a>
          <p class="text-[11px] mt-4" style="color: #6B6B6B;">
            Secure checkout via Stripe · 7-day money-back guarantee
          </p>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="px-4 py-14 md:py-20" style="background: #0C0C0C;">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black text-white text-center mb-10">What Readers Say</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {sp.testimonials.map((t) => (
            <div class="rounded-xl p-5" style="background: #111; border: 1px solid #2D2D2D;">
              <div class="flex items-center gap-1 mb-3">
                {[1, 2, 3, 4, 5].map(() => (
                  <svg class="w-4 h-4" style={`color: ${GOLD};`} fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-sm text-white leading-relaxed mb-3">"{t.text}"</p>
              <p class="text-xs" style="color: #6B6B6B;">{t.name}, {t.location}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- GUARANTEE -->
    <section class="px-4 py-14 md:py-20">
      <div class="max-w-2xl mx-auto rounded-2xl p-8 text-center" style="background: rgba(212,175,55,0.04); border: 1px solid rgba(212,175,55,0.2);">
        <div class="w-14 h-14 mx-auto mb-4 rounded-full flex items-center justify-center" style="background: rgba(212,175,55,0.15);">
          <svg class="w-7 h-7" style={`color: ${GOLD};`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h2 class="text-xl font-black text-white mb-2">{sp.guarantee.title}</h2>
        <p class="text-sm leading-relaxed" style="color: #BEBEBE;">{sp.guarantee.description}</p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="px-4 pb-16 md:pb-24">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-black text-white text-center mb-8">Questions</h2>
        <div class="space-y-3">
          {sp.faqs.map((faq) => (
            <details class="rounded-xl p-5 group" style="background: #111; border: 1px solid #2D2D2D;">
              <summary class="text-white font-semibold text-sm cursor-pointer list-none flex items-center justify-between">
                {faq.question}
                <span style={`color: ${GOLD};`} class="ml-4 group-open:rotate-45 transition-transform text-lg leading-none">+</span>
              </summary>
              <p class="text-sm leading-relaxed mt-3" style="color: #9A9A9A;">{faq.answer}</p>
            </details>
          ))}
        </div>

        <!-- Final CTA -->
        <div class="text-center mt-12">
          <a
            href={checkoutHref}
            class="inline-flex items-center justify-center gap-2 font-black min-h-[56px] rounded-xl px-10 text-lg transition-all hover:brightness-110 active:scale-[0.98]"
            style={`background: ${GOLD}; color: #000;`}
          >
            Get Beat the Casino, ${product.price}
          </a>
        </div>
      </div>
    </section>

    <!-- COMPLIANCE DISCLAIMER -->
    <section class="px-4 pb-16">
      <div class="max-w-2xl mx-auto rounded-lg p-5" style="background: rgba(255,255,255,0.02); border: 1px solid #1A1A1A;">
        <p class="text-[11px] leading-relaxed" style="color: #5A5A5A;">
          <strong style="color: #7A7A7A;">Disclaimer:</strong> This product is for educational and entertainment purposes only.
          Gambling involves real risk and you may lose money. Nothing here constitutes financial advice or a guarantee of
          winnings, no book or system can guarantee you will win, and anyone who promises otherwise is lying. You must be of
          legal gambling age (18+, or 21+ in most US jurisdictions) and follow the laws where you live. If you or someone you
          know has a gambling problem, call or text 1-800-522-4700 (National Problem Gambling Helpline). Always gamble
          responsibly and within your means. By purchasing you agree to our
          <a href="/terms" class="underline" style="color: #7A7A7A;">Terms</a> and
          <a href="/privacy-policy" class="underline" style="color: #7A7A7A;">Privacy Policy</a>.
        </p>
      </div>
    </section>

  </main>

  <FunnelFooter />
</BaseLayout>
