---
/**
 * Cheat Sheets reference page (unofficial fan page)
 * Neutral, fan-made overview of common baccarat, poker, and roulette
 * reference concepts. Sells nothing. No purchase, no pricing, no affiliation.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

// BreadcrumbList schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.mikki-mase.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Cheat Sheets",
      "item": "https://www.mikki-mase.com/cheatsheets"
    }
  ]
};
---

<BaseLayout
  title="Casino Cheat Sheets: Baccarat, Poker & Roulette Basics | Mikki Mase Fan Page"
  description="A plain-language fan reference for baccarat, poker, and roulette basics. Unofficial fan page, not affiliated with or endorsed by Mikki Mase. Sells nothing."
  schema={breadcrumbSchema}
>
  <Header />

  <Hero
    eyebrow="Reference"
    title="Casino Cheat Sheets"
    subtitle="A fan-made plain-language reference for baccarat, poker, and roulette basics"
    backgroundImage="/images/mikki-main-2.webp"
    variant="medium"
  />

  <div class="bg-black border-b border-gray-800">
    <Breadcrumbs items={[
      { label: "Home", href: "/" },
      { label: "Cheat Sheets" }
    ]} />
  </div>

  <!-- INTRO -->
  <section class="py-16 md:py-24 bg-black">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="text-xl md:text-2xl text-gray-300 leading-relaxed">
        Sitting at a table without knowing the optimal move usually
        <span class="text-[#CFB53B] font-semibold"> costs money over time.</span>
      </p>
      <p class="text-xl md:text-2xl text-gray-300 leading-relaxed mt-6">
        This is a fan-made reference that summarizes the basic math behind three common casino games.
      </p>
      <p class="text-base text-gray-500 leading-relaxed mt-8">
        This is an unofficial fan page. It is not affiliated with, run by, or endorsed by Mikki Mase, and it sells nothing.
      </p>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="py-16 md:py-24 bg-gray-900">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-white text-center mb-10">
        Who This Reference Is For
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-[#CFB53B] font-bold mb-4">It may help if</h3>
          <ul class="space-y-3 text-gray-300">
            <li>You play baccarat, poker, or roulette casually</li>
            <li>You want a quick mental reference at the table</li>
            <li>You're tired of guessing the optimal move</li>
            <li>You want to understand the house edge</li>
          </ul>
        </div>
        <div>
          <h3 class="text-gray-400 font-bold mb-4">It will not help if</h3>
          <ul class="space-y-3 text-gray-300">
            <li>You think gambling is guaranteed income</li>
            <li>You're looking for a magic system</li>
            <li>You're not willing to follow a disciplined approach</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT THE BASICS COVER -->
  <section class="py-16 md:py-24 bg-black">
    <div class="max-w-5xl mx-auto px-4">
      <h2 class="font-serif text-3xl md:text-5xl font-bold text-white text-center mb-4">
        The Three Games at a Glance
      </h2>
      <p class="text-xl text-gray-400 text-center mb-12">
        Plain-language summaries. No purchase, no sign-up required.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1: Baccarat -->
        <div class="relative bg-gray-900 border border-[#CFB53B]/30 rounded-xl p-6 border-t-4 border-t-[#CFB53B]">
          <div class="mb-4">
            <svg class="w-10 h-10 text-[#CFB53B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-white text-xl font-bold mb-2">Baccarat</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-4">The Banker bet carries the lowest house edge (1.06%), the Player bet is close behind (1.24%), and the Tie bet is a sucker bet (14.36%).</p>
          <a href="/baccarat-guide" class="text-[#CFB53B] hover:text-[#E5CA50] text-sm font-semibold">Read the full baccarat guide &rarr;</a>
        </div>

        <!-- Card 2: Poker -->
        <div class="relative bg-gray-900 border border-[#CFB53B]/30 rounded-xl p-6 border-t-4 border-t-[#CFB53B]">
          <div class="mb-4">
            <svg class="w-10 h-10 text-[#CFB53B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-white text-xl font-bold mb-2">Poker</h3>
          <p class="text-gray-400 text-sm leading-relaxed">The fundamentals come down to hand rankings, position, and pot odds. Acting later in a hand gives you more information than acting first.</p>
        </div>

        <!-- Card 3: Roulette -->
        <div class="relative bg-gray-900 border border-[#CFB53B]/30 rounded-xl p-6 border-t-4 border-t-[#CFB53B]">
          <div class="mb-4">
            <svg class="w-10 h-10 text-[#CFB53B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-white text-xl font-bold mb-2">Roulette</h3>
          <p class="text-gray-400 text-sm leading-relaxed">European single-zero wheels (2.70% house edge) are better for players than American double-zero wheels (5.26%). Betting systems do not change the underlying edge.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT MIKKI (fan, third-person) -->
  <section class="py-20 md:py-24 bg-black">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="font-serif text-2xl md:text-3xl font-bold text-white text-center mb-10 md:mb-12">
        About Mikki Mase
      </h2>

      <div class="flex flex-col md:grid md:grid-cols-2 gap-10 md:gap-8 items-center">
        <div class="flex justify-center order-1 md:order-2">
          <img
            src="/images/mikki-main-2.webp"
            alt="Mikki Mase"
            class="w-56 h-56 md:w-80 md:h-80 object-cover rounded-xl border-2 border-[#CFB53B]/30"
            loading="lazy"
          />
        </div>

        <div class="text-center md:text-left order-2 md:order-1">
          <p class="text-gray-300 leading-relaxed mb-6">
            Mikki Mase is a public figure who says he won more than $32M at baccarat and was banned from 150+ casinos. The notes on this page are a fan summary based on his public podcasts and interviews.
          </p>
          <div class="grid grid-cols-1 gap-4 md:space-y-4 md:block mb-8">
            <div class="flex flex-col md:flex-row items-center md:items-center gap-1 md:gap-3 py-3 md:py-0 border-b border-gray-800 md:border-0">
              <span class="text-[#CFB53B] font-bold text-2xl md:text-lg">$32M+</span>
              <span class="text-gray-300 text-base md:text-lg">in winnings he describes</span>
            </div>
            <div class="flex flex-col md:flex-row items-center md:items-center gap-1 md:gap-3 py-3 md:py-0 border-b border-gray-800 md:border-0">
              <span class="text-[#CFB53B] font-bold text-2xl md:text-lg">150+</span>
              <span class="text-gray-300 text-base md:text-lg">casino bans he describes</span>
            </div>
            <div class="flex flex-col md:flex-row items-center md:items-center gap-1 md:gap-3 py-3 md:py-0">
              <span class="text-[#CFB53B] font-bold text-sm md:text-lg uppercase tracking-wide">Featured in</span>
              <span class="text-gray-300 text-sm md:text-lg">NELK, Bert Kreischer, Soft White Underbelly</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center md:justify-start">
            <a href="/story" class="text-[#CFB53B] hover:text-[#E5CA50] underline underline-offset-4 py-2">
              Read His Full Story &rarr;
            </a>
            <a href="/banned" class="text-[#CFB53B] hover:text-[#E5CA50] underline underline-offset-4 py-2">
              See the Casino Bans &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FREE COMMUNITY CTA (no sale) -->
  <section class="py-16 md:py-24 bg-gradient-to-b from-gray-900 to-black">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="font-serif text-3xl md:text-5xl font-bold text-white mb-6">
        Keep Learning the Math
      </h2>

      <p class="text-xl text-gray-300 mb-8">
        The house has an edge. Understanding it is the first step to playing smarter.
      </p>

      <p class="text-gray-400 mb-8">
        Join the free fan community for discussion and free guides. No purchase, no special access.
      </p>

      <Button variant="primary" href="/join">
        Join the Free Fan Community
      </Button>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* Mobile-specific improvements */
  @media (max-width: 767px) {
    :global(.text-lg),
    :global(.text-xl) {
      line-height: 1.75 !important;
    }

    :global(.text-gray-300),
    :global(.text-gray-400) {
      line-height: 1.7;
    }

    :global(section.py-16) {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }
</style>
