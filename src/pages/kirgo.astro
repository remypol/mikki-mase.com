      [25.4, 29.6, "We can't make a deal if you won't let me take an honest look."],
      [29.6, 31.7, "If you've got nothing to hide — what do you even care?"],
      [31.7, 35.6, "If I don't think it's good for somebody, I don't want to post it."],
      [35.6, 38.9, "I'm way less concerned with *me making money* than *my fans losing money*."],
      [38.9, 42.2, "We're gonna do a deep dive. If everything checks out, we can talk again."],
      [42.4, 46.5, 'You played a thousand hands of blackjack?'],
      [46.5, 50.5, "What was the win rate? — *54%*, and I'm actually happy with it."],
      [50.6, 54.3, 'When you withdrew the money, how long did it take?'],
      [54.3, 57.5, '*Immediately.* Immediately.'],
      [62.4, 64.6, "It's not money — it's *confidence*."],
      [64.7, 67.8, 'I took a look, and everything seemed okay.'],
      [67.8, 70.5, "If we're gonna do this: full communication, *full transparency*."],
      [70.5, 75.4, 'If or when I find anything out of line, I am going to post about it.'],
      [75.4, 78.5, 'I expect you to post about it, sir.'],
      [81.5, 88.0, "At least now you know: if you play on Kirgo, *you won't get cheated*."]
    ];

    // Caption-engine: rAF-loop synct cues op currentTime
    var reel = document.getElementById('mikki-reel');
    var capsEl = document.getElementById('reel-caps');
    if (reel && capsEl) {
      var activeCue = -1;
      function esc(s) {
        return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }
      function renderCue(i) {
        if (i === activeCue) return;
        activeCue = i;
        if (i < 0) { capsEl.innerHTML = ''; return; }
        var html = esc(CUES[i][2]).replace(/\*([^*]+)\*/g, '<span class="hl">$1</span>');
        capsEl.innerHTML = '<span class="cap">' + html + '</span>';
      }
      function tick() {
        var t = reel.currentTime;
        var found = -1;
        for (var i = 0; i < CUES.length; i++) {
          if (t >= CUES[i][0] && t < CUES[i][1]) { found = i; break; }
        }
        renderCue(found);
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    // Reel: geluid aan/uit
    var soundBtn = document.getElementById('reel-sound');
    if (reel && soundBtn) {
      soundBtn.addEventListener('click', function () {
        reel.muted = !reel.muted;
        if (!reel.muted) { reel.currentTime = 0; reel.play(); }
        soundBtn.setAttribute('aria-pressed', String(!reel.muted));
        soundBtn.innerHTML = reel.muted
          ? soundBtn.innerHTML.replace('Sound on', 'Tap for sound')
          : soundBtn.innerHTML.replace('Tap for sound', 'Sound on');
        gtag('event', 'reel_sound_toggle', { muted: reel.muted });
      });
    }

    // Scroll-reveal voor de stappen
    var steps = document.querySelectorAll('.step');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e, i) {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.3 });
      steps.forEach(function (s, i) {
        s.style.transitionDelay = (i * 120) + 'ms';
        io.observe(s);
      });
    } else {
      steps.forEach(function (s) { s.classList.add('visible'); });
    }
  </script>
