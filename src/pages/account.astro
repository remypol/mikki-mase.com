---
/**
 * Account page — authenticated user hub.
 * Exists as a direct response to the post-paywall audit finding that NO
 * account/billing/logout pages existed anywhere in the paid product.
 *
 * Server-rendered so we can redirect unauthenticated users to /auth/login.
 */

export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AccountPanel from '../components/account/AccountPanel.tsx';
import { getServerClient } from '../lib/supabase';

const supabase = getServerClient(Astro.cookies, Astro.request);
const { data: { user } } = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/auth/login?next=/account');
}
---

<BaseLayout
  title="Your account | Mikki Mase"
  description="Manage your Mikki Mase subscription, billing, and session."
  noIndex={true}
>
  <Header />

  <main id="main-content" class="bg-page min-h-screen">
    <AccountPanel client:load />
  </main>

  <Footer />
</BaseLayout>
