# Mikki Mase Shop - Environment Variables
# Copy this file to .env.local for development

# ============================================
# STRIPE PAYMENT PROCESSING
# ============================================

# Stripe API Keys (from Stripe Dashboard > Developers > API Keys)
# Use test keys for development (sk_test_, pk_test_)
# Use live keys for production (sk_live_, pk_live_)
STRIPE_SECRET_KEY=sk_test_xxx
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Stripe Webhook Secret (from Stripe Dashboard > Developers > Webhooks)
# Create endpoint: https://mikki-mase.com/api/webhook/stripe
# Events: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ============================================
# RESEND EMAIL SERVICE
# ============================================

# Resend API Key (from resend.com dashboard)
RESEND_API_KEY=re_xxx

# ============================================
# DOWNLOAD SECURITY
# ============================================

# Secret for signing download tokens (generate with: openssl rand -hex 32)
DOWNLOAD_TOKEN_SECRET=your-256-bit-secret-here

# Token expiry in seconds (default: 604800 = 7 days)
DOWNLOAD_TOKEN_EXPIRY=604800

# ============================================
# SUPABASE
# ============================================

# Supabase Project URL and Keys (from Supabase Dashboard > Settings > API)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================
# SITE CONFIGURATION
# ============================================

# Site URL (no trailing slash)
SITE_URL=https://mikki-mase.com

# ============================================
# STRIPE PRODUCTS (Legacy — keep for existing customers)
# ============================================

STRIPE_MASTERCLASS_PRICE_ID=price_xxx
STRIPE_MASTERCLASS_PRODUCT_ID=prod_xxx
STRIPE_INNER_CIRCLE_MONTHLY_PRICE_ID=price_xxx
STRIPE_INNER_CIRCLE_YEARLY_PRICE_ID=price_xxx
STRIPE_INNER_CIRCLE_PRODUCT_ID=prod_xxx
STRIPE_LIFETIME_VIP_PRICE_ID=price_xxx
STRIPE_LIFETIME_VIP_PRODUCT_ID=prod_xxx

# ============================================
# STRIPE PRODUCTS (v2 Funnel — new)
# ============================================

# Session Playbook — $27 one-time (front-end)
STRIPE_PLAYBOOK_PRICE_ID=price_xxx
STRIPE_PLAYBOOK_PRODUCT_ID=prod_xxx

# Session Toolkit — $9 one-time (order bump)
STRIPE_TOOLKIT_PRICE_ID=price_xxx
STRIPE_TOOLKIT_PRODUCT_ID=prod_xxx

# Full Masterclass — $79 one-time (OTO upsell)
STRIPE_FULL_MASTERCLASS_PRICE_ID=price_xxx
STRIPE_FULL_MASTERCLASS_PRODUCT_ID=prod_xxx

# Inner Circle v2 — $29/mo or $249/yr (backend, after activation)
STRIPE_IC_V2_MONTHLY_PRICE_ID=price_xxx
STRIPE_IC_V2_YEARLY_PRICE_ID=price_xxx
STRIPE_IC_V2_PRODUCT_ID=prod_xxx

# ============================================
# STRIPE PRODUCTS (High-Roller all-PDF funnel — June 2026)
# Routes live under /funnel/*. Until these real IDs are set, the funnel
# renders + builds but live charging is gated (placeholders are used).
# ============================================

# FRONT — Beat the Casino $27
STRIPE_BF_BTC_PRICE_ID=price_xxx
STRIPE_BF_BTC_PRODUCT_ID=prod_xxx

# BUMP — The Casino Cheat Sheet Pack $17
STRIPE_BF_CHEATPACK_PRICE_ID=price_xxx
STRIPE_BF_CHEATPACK_PRODUCT_ID=prod_xxx

# OTO1 — The Advantage Player's Vault $47
STRIPE_BF_VAULT_PRICE_ID=price_xxx
STRIPE_BF_VAULT_PRODUCT_ID=prod_xxx

# DOWNSELL1 — The Advantage Player's Vault $27 (same PDF)
STRIPE_BF_VAULT_DS_PRICE_ID=price_xxx
STRIPE_BF_VAULT_DS_PRODUCT_ID=prod_xxx

# OTO2 — The Blackjack Bundle $37 (ebook + calculators zip)
STRIPE_BF_BJ_BUNDLE_PRICE_ID=price_xxx
STRIPE_BF_BJ_BUNDLE_PRODUCT_ID=prod_xxx

# DOWNSELL2 — The Blackjack Edge $19 (ebook only)
STRIPE_BF_BJ_EDGE_DS_PRICE_ID=price_xxx
STRIPE_BF_BJ_EDGE_DS_PRODUCT_ID=prod_xxx

# ============================================
# TELEGRAM NOTIFICATIONS
# ============================================

# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram Chat ID (group or user ID to receive notifications)
# To get: add bot to group, send a message, then visit:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ============================================
# AI SUPPORT CHAT (Anthropic Claude)
# ============================================

# Anthropic API Key (from console.anthropic.com)
# Used for the AI support chat on /support page
ANTHROPIC_API_KEY=sk-ant-xxx
